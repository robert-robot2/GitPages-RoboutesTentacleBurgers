    <!-- CALCULATOR -->
    <div id="calculator">
        <section class="se-section">

            <div class="se-section-sub">Live Calculator</div>

            <h2 class="se-section-title">
                Power budget &amp; torque estimator
            </h2>

            <p class="se-section-lead">
                Adjust the parameters below to update the illustrative model in real time.
                The calculated values are estimates and are not a substitute for detailed
                thermodynamic or vehicle engineering analysis.
            </p>

            <div class="se-calc">

                <!-- PSI -->
                <div class="se-slider-row">
                    <label for="psiSlider">Steam pressure (psi)</label>

                    <input id="psiSlider"
                           type="range"
                           min="100"
                           max="700"
                           step="25"
                           @bind="Psi"
                           @bind:event="oninput"
                           @bind:after="Recalc" />

                    <span class="val">@Psi.ToString("F0") psi</span>
                </div>

                <!-- BORE -->
                <div class="se-slider-row">
                    <label for="boreSlider">Cylinder bore (inches)</label>

                    <input id="boreSlider"
                           type="range"
                           min="3"
                           max="10"
                           step="0.5"
                           @bind="Bore"
                           @bind:event="oninput"
                           @bind:after="Recalc" />

                    <span class="val">@Bore.ToString("F1") in</span>
                </div>

                <!-- CYLINDERS -->
                <div class="se-slider-row">
                    <label for="cylinderSlider">Number of cylinders</label>

                    <input id="cylinderSlider"
                           type="range"
                           min="2"
                           max="12"
                           step="2"
                           @bind="Cylinders"
                           @bind:event="oninput"
                           @bind:after="Recalc" />

                    <span class="val">@Cylinders cyl</span>
                </div>

                <!-- WEIGHT -->
                <div class="se-slider-row">
                    <label for="weightSlider">Vehicle weight (lb)</label>

                    <input id="weightSlider"
                           type="range"
                           min="800"
                           max="80000"
                           step="100"
                           @bind="WeightLb"
                           @bind:event="oninput"
                           @bind:after="Recalc" />

                    <span class="val">
                        @WeightLb.ToString("N0") lb
                    </span>
                </div>

                <!-- PWM -->
                <div class="se-slider-row">
                    <label for="pwmSlider">PWM efficiency (%)</label>

                    <input id="pwmSlider"
                           type="range"
                           min="70"
                           max="98"
                           step="1"
                           @bind="PwmEff"
                           @bind:event="oninput"
                           @bind:after="Recalc" />

                    <span class="val">@PwmEff%</span>
                </div>

                <!-- METRICS -->
                <div class="se-metrics">

                    <div class="se-metric">
                        <div class="mn">
                            @SteamTorque.ToString("N0")
                        </div>

                        <div class="ml">
                            estimated ft-lb torque
                        </div>
                    </div>

                    <div class="se-metric">
                        <div class="mn">
                            @TorqueRatio.ToString("F1")×
                        </div>

                        <div class="ml">
                            relative comparison
                        </div>
                    </div>

                    <div class="se-metric">
                        <div class="mn">
                            @RoadLoadW.ToString("N0") W
                        </div>

                        <div class="ml">
                            road load at 55 mph
                        </div>
                    </div>

                    <div class="se-metric">
                        <div class="mn">
                            @NetDrawW.ToString("N0") W
                        </div>

                        <div class="ml">
                            estimated net battery draw
                        </div>
                    </div>

                </div>

                <!-- TORQUE COMPARISON -->
                <h3 class="se-subheading">
                    Torque comparison
                </h3>

                <div class="se-bar-wrap">

                    <div class="se-bar-label">
                        <span>Reference diesel</span>
                        <span>2,050 ft-lb at 1,200 rpm</span>
                    </div>

                    <div class="se-bar-track">

                        <div class="se-bar-fill"
                             style="width:35%;background:#cc4400;">
                            2,050 ft-lb
                        </div>

                    </div>
                </div>

                <div class="se-bar-wrap">

                    <div class="se-bar-label">
                        <span>Your steam model</span>

                        <span>
                            @SteamTorque.ToString("N0") ft-lb
                        </span>
                    </div>

                    <div class="se-bar-track">

                        <div class="se-bar-fill"
                             style="@GetTorqueBarStyle()">

                            @SteamTorque.ToString("N0") ft-lb

                        </div>

                    </div>
                </div>

            </div>
        </section>
    </div>

    <!-- TRUCK -->
    <div class="se-section-full" id="truck">

        <section class="se-section">

            <div class="se-section-sub">
                Heavy Haul Concept
            </div>

            <h2 class="se-section-title">
                Steam-electric semi truck
            </h2>

            <p class="se-section-lead">
                A conceptual heavy-haul architecture using a steam power block,
                generator, battery system, and multiple electric drive motors.
                Actual performance would require detailed vehicle simulation,
                thermal modeling, component testing, and certification.
            </p>

            <div class="se-card-grid">

                <div class="se-card">

                    <div class="se-card-icon">🚛</div>

                    <h3>
                        Conventional Diesel Reference
                    </h3>

                    <p>
                        Modern heavy-duty diesel engines provide substantial torque,
                        but their peak torque occurs within a specific RPM range and
                        is managed through a transmission.
                    </p>

                </div>

                <div class="se-card"
                     style="border-color:#4ab4ff;">

                    <div class="se-card-icon">💨</div>

                    <h3>
                        Steam-Electric Concept Hauler
                    </h3>

                    <p>
                        A multi-cylinder steam engine could provide mechanical power
                        while electric motors provide wheel torque and electronic
                        traction control.
                    </p>

                </div>

                <div class="se-card">

                    <div class="se-card-icon">📊</div>

                    <h3>
                        Grade Climbing
                    </h3>

                    <p>
                        Electric traction motors can provide precise low-speed torque
                        control. The actual grade capability depends on motor power,
                        gearing, traction, thermal limits, and vehicle mass.
                    </p>

                </div>

            </div>

            <div style="margin-top:2rem;">

                <div class="se-bar-wrap">

                    <div class="se-bar-label">
                        <span>Diesel reference</span>
                        <span>1,850 ft-lb</span>
                    </div>

                    <div class="se-bar-track">

                        <div class="se-bar-fill"
                             style="width:32%;background:#cc4400;">
                            1,850 ft-lb
                        </div>

                    </div>
                </div>

                <div class="se-bar-wrap">

                    <div class="se-bar-label">
                        <span>Higher-output diesel reference</span>
                        <span>2,050 ft-lb</span>
                    </div>

                    <div class="se-bar-track">

                        <div class="se-bar-fill"
                             style="width:36%;background:#993300;">
                            2,050 ft-lb
                        </div>

                    </div>
                </div>

                <div class="se-bar-wrap">

                    <div class="se-bar-label">
                        <span>Illustrative steam V8</span>
                        <span>~3,200 ft-lb</span>
                    </div>

                    <div class="se-bar-track">

                        <div class="se-bar-fill"
                             style="width:56%;background:#1a6aaa;">
                            ~3,200 ft-lb
                        </div>

                    </div>
                </div>

                <div class="se-bar-wrap">

                    <div class="se-bar-label">
                        <span>Illustrative steam + electric drive</span>
                        <span>~5,800 ft-lb</span>
                    </div>

                    <div class="se-bar-track">

                        <div class="se-bar-fill"
                             style="width:100%;background:#4aff90;color:#001a10;">
                            ~5,800 ft-lb
                        </div>

                    </div>
                </div>

            </div>

        </section>
    </div>

    <!-- IMPACT -->
    <div id="impact">

        <section class="se-section">

            <div class="se-section-sub">
                Ecosystem &amp; Resource Impact
            </div>

            <h2 class="se-section-title">
                Oil vs water — system-level comparison
            </h2>

            <p class="se-section-lead">
                Water can serve as the working fluid in a closed steam cycle.
                However, replacing fossil fuels with electrically generated heat
                does not automatically make the complete system zero-emission;
                lifecycle emissions depend on the electricity source and equipment.
            </p>

            <div class="se-table-wrap">

                <table class="se-table">

                    <thead>
                        <tr>
                            <th>Factor</th>
                            <th>Combustion system</th>
                            <th>Steam-electric concept</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>Working fluid</td>

                            <td class="bad">
                                Fuel combustion products
                            </td>

                            <td class="good">
                                Water / steam
                            </td>
                        </tr>

                        <tr>
                            <td>Tailpipe combustion CO₂</td>

                            <td class="bad">
                                Produced during fuel combustion
                            </td>

                            <td class="good">
                                No combustion at vehicle point of use
                            </td>
                        </tr>

                        <tr>
                            <td>Electricity requirement</td>

                            <td>
                                Usually not the primary energy source
                            </td>

                            <td class="good">
                                Central to the proposed architecture
                            </td>
                        </tr>

                        <tr>
                            <td>Spill risk</td>

                            <td class="bad">
                                Fuel can be flammable and environmentally damaging
                            </td>

                            <td class="good">
