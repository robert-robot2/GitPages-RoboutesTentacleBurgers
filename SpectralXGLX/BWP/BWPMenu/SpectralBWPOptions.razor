@implements IDisposable

<div style="
    position: absolute;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: radial-gradient(ellipse at center, rgba(20,0,0,0.85) 0%, rgba(0,0,0,0.96) 100%);
    pointer-events: all;
    font-family: 'Courier New', monospace;">

    @* ── Title ────────────────────────────────────────────────────── *@
    <div style="
        font-size: 3.5rem;
        font-family: 'Diablo', 'Courier New', monospace;
        font-weight: normal;
        letter-spacing: 0.08em;
        color: #cc2200;
        text-shadow: 0 0 18px #ff4400, 0 0 40px #aa1100, 0 0 80px #660000;
        margin-bottom: 0px;
        text-transform: none;
        text-align: center;">
        Options
    </div>

    @* ── Lore Text ────────────────────────────────────────────────── *@
    <div style="
        max-width: 420px;
        text-align: center;
        color: rgba(255,255,255,0.45);
        font-size: 0.72rem;
        line-height: 1.8;
        letter-spacing: 0.06em;
        margin-bottom: 32px;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 4px;
        padding: 14px 18px;
        background: rgba(0,0,0,0.3);">
        Beware of Cows....<br />
        Try to Defeat the Evil....<br />
        Use SignPosts to Travel to New Areas <br/>
        Cain spoke in the wind of rumors of a town to the west in construction...<br />
        You Must eat Cheese to Survive The Horror...<br />
        Map Coords As follow Planet, X, Y, Z...<br />
        Refresh Browser to Fully Reset
    </div>

    @* ── Options Panel ────────────────────────────────────────────── *@
    <div style="
        display: flex;
        flex-direction: column;
        gap: 16px;
        width: 320px;
        background: rgba(0,0,0,0.45);
        border: 1px solid rgba(204,34,0,0.25);
        border-radius: 4px;
        padding: 18px 20px;
        margin-bottom: 28px;">

        @* ── Lighting Placeholder ─────────────────────────────────── *@
        <div style="
            font-size: 0.7rem;
            color: rgba(255,255,255,0.2);
            letter-spacing: 0.1em;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding-bottom: 10px;
            margin-bottom: 4px;">
            LIGHTING CONTROLS — COMING SOON
        </div>

        @* Pause Day/Night placeholder row *@
        <div style="
            display: flex;
            align-items: center;
            gap: 10px;
            opacity: 0.35;
            pointer-events: none;">
            <input type="checkbox" disabled />
            <span style="font-size:0.78rem; color:#ccc; letter-spacing:0.08em;">
                Pause Day / Night Cycle
            </span>
        </div>

        @* Cycle Duration placeholder row *@
        <div style="
            display: flex;
            flex-direction: column;
            gap: 6px;
            opacity: 0.35;
            pointer-events: none;">
            <span style="font-size:0.72rem; color:#aaa; letter-spacing:0.08em;">
                Day / Night Cycle Duration (minutes)
            </span>
            <input type="range" min="2" max="1440" step="1" value="60" disabled
                   style="width:100%; accent-color:#cc2200;" />
            <span style="font-size:0.7rem; color:#888;">60 min</span>
        </div>

    </div>

    @* ── Back Button ──────────────────────────────────────────────── *@
    <button style="
        width: 260px; padding: 12px 8px;
        font-size: 0.85rem;
        font-family: 'Courier New', monospace;
        letter-spacing: 0.12em;
        background: rgba(0,0,0,0.6);
        color: #ddd;
        border: 1px solid #882200;
        border-radius: 3px;
        cursor: pointer;
        text-align: center;
        text-shadow: 0 0 8px #cc4400;
        box-shadow: 0 0 10px #88220044;"
            @onclick="OnRMainMenuPressed">
        ← MAIN MENU
    </button>

    @* ── Footer ───────────────────────────────────────────────────── *@
    <div style="
        position: absolute;
        bottom: 18px;
        font-size: 0.7rem;
        color: rgba(255,255,255,0.2);
        letter-spacing: 0.12em;">
        PRESS 5 TO CLOSE
    </div>

</div>

@code {

    [Parameter] public EventCallback OnRMainMenu { get; set; }

    // ── Lighting placeholder — wire these up when ILighting is ready ──
    // [Parameter] public bool IsDayNightCyclePaused { get; set; }
    // [Parameter] public EventCallback<bool> IsDayNightCyclePausedChanged { get; set; }
    // [Parameter] public int CycleDurationMinutes { get; set; } = 60;
    // [Parameter] public EventCallback<int> CycleDurationMinutesChanged { get; set; }

    private async Task OnRMainMenuPressed() => await OnRMainMenu.InvokeAsync();

    public void Dispose() { }
}
