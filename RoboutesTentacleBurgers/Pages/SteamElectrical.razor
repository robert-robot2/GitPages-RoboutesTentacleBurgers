{
    // ============================================================
    // Slider state
    // ============================================================

    private double Psi { get; set; } = 350;
    private double Bore { get; set; } = 6;
    private int Cylinders { get; set; } = 4;
    private double WeightLb { get; set; } = 1500;
    private int PwmEff { get; set; } = 92;

    // ============================================================
    // Computed outputs
    // ============================================================

    private double SteamTorque { get; set; }
    private double TorqueRatio { get; set; }
    private double TorqueBarPct { get; set; }
    private double RoadLoadW { get; set; }
    private double NetDrawW { get; set; }

    // ============================================================
    // Initialization
    // ============================================================

    protected override void OnInitialized()
    {
        Recalc();
    }

    // ============================================================
    // Calculator
    // ============================================================

    private void Recalc()
    {
        // --------------------------------------------------------
        // Illustrative steam torque model
        // --------------------------------------------------------

        double stroke = Bore * 1.2;

        double pistonArea =
            Math.PI * Math.Pow(Bore / 2.0, 2);

        double forcePerCylinder =
            Psi * pistonArea;

        double torquePerCylinder =
            (forcePerCylinder * (stroke / 24.0)) / 12.0;

        SteamTorque =
            Math.Round(
                torquePerCylinder *
                Cylinders *
                0.72
            );

        // --------------------------------------------------------
        // Reference comparison
        // --------------------------------------------------------

        const double dieselBest = 2050.0;

        TorqueRatio =
            dieselBest > 0
                ? Math.Round(SteamTorque / dieselBest, 1)
                : 0;

        TorqueBarPct =
            Math.Min(
                95,
                Math.Max(
                    0,
                    Math.Round(
                        (SteamTorque / 6000.0) * 95
                    )
                )
            );

        // --------------------------------------------------------
        // Road-load estimate at 55 mph
        // --------------------------------------------------------

        double weightKg =
            WeightLb * 0.453592;

        double speedMs =
            55 * 0.44704;

        // Illustrative aerodynamic parameters.
        double airDensity = 1.225;
        double dragCoefficient = 0.28;
        double frontalArea = 2.0;

        double aeroDrag =
            0.5 *
            airDensity *
            dragCoefficient *
            frontalArea *
            speedMs *
            speedMs;

        double rollingCoefficient = 0.015;

        double rollDrag =
            rollingCoefficient *
            weightKg *
            9.81;

        RoadLoadW =
            Math.Round(
                (aeroDrag + rollDrag) *
                speedMs
            );

        // --------------------------------------------------------
        // Illustrative power loop
        // --------------------------------------------------------

        double rankineEff = 0.35;

        double steamPowerW =
            RoadLoadW / rankineEff;

        double pwmEfficiency =
            Math.Max(0.01, PwmEff / 100.0);

        double heatInputW =
            steamPowerW / pwmEfficiency;

        double generatorEfficiency = 0.82;
        double generatorConversion = 0.40;

        double genOutputW =
            steamPowerW *
            generatorEfficiency *
            generatorConversion;

        double regenW =
            RoadLoadW * 0.18;

        NetDrawW =
            Math.Max(
                0,
                Math.Round(
                    heatInputW -
                    genOutputW -
                    regenW
                )
            );
    }

    // ============================================================
    // Dynamic torque bar style
    // ============================================================

    private string GetTorqueBarStyle()
    {
        return
            $"width:{TorqueBarPct:F0}%;background:#4ab4ff;";
    }

    // ============================================================
    // IDisposable
    // ============================================================

    public void Dispose()
    {
    }
}

