    const rT = parseFloat(document.getElementById('reportedTime').value);

    document.getElementById('hollingsEarlyDisplay').textContent = formatHour(hE);
    document.getElementById('hollingsLateDisplay').textContent = formatHour(hL);
    document.getElementById('perettiEarlyDisplay').textContent = formatHour(pE);
    document.getElementById('perettiLateDisplay').textContent = formatHour(pL);
    document.getElementById('prosEarlyDisplay').textContent = formatHour(prE);
    document.getElementById('prosLateDisplay').textContent = formatHour(prL);
    document.getElementById('lastSeenDisplay').textContent = formatHour(lsT);
    document.getElementById('reportedDisplay').textContent = formatHour(rT);

    // CONFLICT ANALYSIS
    // Does prosecution claim overlap with Peretti TOD?
    const prosOverlapsPeretti = prE <= pL && prL >= pE;
    // Gap between Hollingsworth and Peretti TOD earliest
    const gapHours = pE - hL;
    // Does prosecution window contradict medical examiner completely?
    const prosBelowPeretti = prL < pE;

    const result = document.getElementById('conflictResult');
    const verdict = document.getElementById('conflictVerdict');
    const detail = document.getElementById('conflictDetail');

    if (prosBelowPeretti) {
      result.className = 'conflict-result no-overlap';
      verdict.textContent = '⚠ CRITICAL INTERNAL CONTRADICTION CONFIRMED';
      detail.innerHTML = `The prosecution placed murders at ${formatHour(prE)}–${formatHour(prL)}.<br>
      The prosecution's own Medical Examiner placed death at ${formatHour(pE)}–${formatHour(pL)}.<br>
      These two claims DO NOT OVERLAP by ${gapHours.toFixed(1)} hours.<br><br>
      The Hollingsworth sighting at ${formatHour(hE)}–${formatHour(hL)} cannot simultaneously be evidence of murder AND precede the medical examiner's time of death by ${(pE - hL).toFixed(1)} hours.<br><br>
      LEGAL CONCLUSION: The prosecution used the Hollingsworth sighting to establish presence at scene WHILE their own expert testified murder happened hours later. These cannot both be used against the same defendants. This is an irreconcilable internal contradiction that should have created reasonable doubt.`;
    } else if (prosOverlapsPeretti) {
      result.className = 'conflict-result partial';
      verdict.textContent = '◈ PARTIAL OVERLAP — TIMELINE REMAINS AMBIGUOUS';
      detail.innerHTML = `With these adjusted settings the prosecution window (${formatHour(prE)}–${formatHour(prL)}) partially overlaps the medical examiner window (${formatHour(pE)}–${formatHour(pL)}).<br><br>
      However the Hollingsworth sighting at ${formatHour(hE)} still places Echols at the scene ${(pE - hE).toFixed(1)} hours before the earliest possible time of death.<br><br>
