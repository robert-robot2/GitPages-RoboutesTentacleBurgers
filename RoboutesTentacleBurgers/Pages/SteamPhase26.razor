    <div class="metric"><div class="val" style="color:var(--boiler)">378L</div><div class="lbl">Vessel Capacity</div></div>
    <div class="metric"><div class="val" style="color:var(--boiler)">MULTI</div><div class="lbl">Copper Bowls</div></div>
    <div class="metric"><div class="val" style="color:var(--bowl)">90°</div><div class="lbl">Bowl Hemisphere</div></div>
    <div class="metric"><div class="val" style="color:var(--steam)">90</div><div class="lbl">PSI Idle</div></div>
    <div class="metric"><div class="val" style="color:var(--safe)">500</div><div class="lbl">PSI Maximum</div></div>
    <div class="metric"><div class="val" style="color:var(--safe)">600</div><div class="lbl">PSI PRV Spring</div></div>
    <div class="metric"><div class="val" style="color:var(--boiler)">FRONT</div><div class="lbl">Chassis Position</div></div>
    <div class="metric"><div class="val" style="color:var(--elec)">TBD</div><div class="lbl">Bowl Count Ph27</div></div>
    <div class="metric"><div class="val" style="color:var(--elec)">TBD</div><div class="lbl">Heater kW Total</div></div>
    <div class="metric"><div class="val" style="color:var(--new)">DUAL</div><div class="lbl">EWI Injectors</div></div>
    <div class="metric"><div class="val" style="color:var(--new)">SS 316L</div><div class="lbl">Vessel Material</div></div>
  </div>

  <div class="schem">
  <svg width="100%" viewBox="0 0 1400 700" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="bg26" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#e8c060" stop-opacity=".15"/><stop offset="100%" stop-color="#e8c060" stop-opacity="0"/></radialGradient>
    <radialGradient id="sg26" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#39ff14" stop-opacity=".1"/><stop offset="100%" stop-color="#39ff14" stop-opacity="0"/></radialGradient>
    <filter id="gf26"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <marker id="as26" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#39ff14"/></marker>
    <marker id="ai26" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#00bfff"/></marker>
    <marker id="ab26" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#cc2200"/></marker>
  </defs>
  <rect width="1400" height="700" fill="#000008"/>
  <text x="700" y="22" text-anchor="middle" font-size="12" fill="#e8c060" font-family="Courier New" font-weight="700" letter-spacing="2">MACK BERSERKER — MULTI-BOWL FLASH BOILER — PHASE 26 CONCEPT</text>
  <text x="700" y="38" text-anchor="middle" font-size="9" fill="#404060" font-family="Courier New">100 gallon SS 316L vessel · multiple Aegis copper bowls · front engine bay · design TBD Phase 27</text>

  <!-- Main vessel outline -->
