            <div class="data-line"><span class="data-key">HEADING</span><span class="data-val" id="heading">047.3°</span></div>
            <div class="data-line"><span class="data-key">VELOCITY</span><span class="data-val">0.004c</span></div>
            <div class="data-line"><span class="data-key">DEST ETA</span><span class="data-val">14h 22m</span></div>
            <div class="data-line"><span class="data-key">GRAV DRIFT</span><span class="data-val">-0.002°</span></div>
            <div class="btn-row">
                <button class="btn" onclick="sendPrompt('Calculate optimal plasma burn trajectory to intercept BOGEY-01 for the Yautja frigate Blood Fang at 0.004c')">ᛃ PLOT INTERCEPT ↗</button>
            </div>
            <div class="scrolling-glyph">ᛃᚷᛦᚩᛉᛃᚷᛦᚩᛉᛃᚷᛦᚩᛉᛃᚷᛦᚩ</div>
        </div>

        <div class="monitor" id="m15">
            <div class="mon-id">M-15 / M-16</div>
            <div class="mon-title">ᚢᚾᛏ — CREW STATUS</div>
            <div class="crew-grid">
                <div class="crew-card"><div class="crew-name">꩜ COMMANDER</div><div class="crew-role">SCAR-7</div><div class="crew-vital">♥ 98%</div></div>
                <div class="crew-card"><div class="crew-name">ᛦ ENGINEER</div><div class="crew-role">KETH-3</div><div class="crew-vital">♥ 100%</div></div>
                <div class="crew-card"><div class="crew-name">ᚩ WEAPONS</div><div class="crew-role">DRAK-2</div><div class="crew-vital">♥ 94%</div></div>
                <div class="crew-card"><div class="crew-name">ᚱ NAVIGATOR</div><div class="crew-role">VAL-9</div><div class="crew-vital">♥ 100%</div></div>
                <div class="crew-card"><div class="crew-name">ᚹ COMMS</div><div class="crew-role">MEL-1</div><div class="crew-vital">♥ 97%</div></div>
                <div class="crew-card"><div class="crew-name">ᛞ MEDIC</div><div class="crew-role">ZEL-5</div><div class="crew-vital">♥ 100%</div></div>
            </div>
            <div class="scrolling-glyph">ᚢᚾᛏᛃᚷᚢᚾᛏᛃᚷᚢᚾᛏᛃᚷᚢᚾᛏᛃ</div>
        </div>

    </div>

    <div style="grid-column:1/-1;display:grid;grid-template-columns:repeat(5,1fr);gap:4px">

        <div class="monitor" id="m17">
            <div class="mon-id">M-17</div>
            <div class="mon-title">ᛦᚱᛃ — HULL INTEGRITY</div>
            <div class="bar-row"><span class="bar-label">BOW</span><div class="bar-track"><div class="bar-fill" style="width:98%"></div></div><span class="bar-val">98%</span></div>
            <div class="bar-row"><span class="bar-label">PORT</span><div class="bar-track"><div class="bar-fill" style="width:97%"></div></div><span class="bar-val">97%</span></div>
            <div class="bar-row"><span class="bar-label">STARBD</span><div class="bar-track"><div class="bar-fill" style="width:95%"></div></div><span class="bar-val">95%</span></div>
            <div class="bar-row"><span class="bar-label">AFT</span><div class="bar-track"><div class="bar-fill" style="width:99%"></div></div><span class="bar-val">99%</span></div>
            <div class="bar-row"><span class="bar-label">SHIELDS</span><div class="bar-track"><div class="bar-fill" id="shieldBar" style="width:84%"></div></div><span class="bar-val" id="shieldVal">84%</span></div>
        </div>

        <div class="monitor" id="m18">
            <div class="mon-id">M-18</div>
            <div class="mon-title">ᚩᚢᛞ — DAMAGE CTRL</div>
            <div class="data-line"><span class="data-key">SECTION A</span><span class="data-val">NOMINAL</span></div>
            <div class="data-line"><span class="data-key">SECTION B</span><span class="data-val">NOMINAL</span></div>
            <div class="data-line"><span class="data-key">SECTION C</span><span class="data-val">NOMINAL</span></div>
            <div class="data-line"><span class="data-key">SECTION D</span><span class="data-val">NOMINAL</span></div>
            <div class="data-line"><span class="data-key">REPAIR BOTS</span><span class="data-val">12 ACTIVE</span></div>
            <div class="btn-row"><button class="btn" onclick="deployRepair()">ᚹ DEPLOY BOTS</button></div>
        </div>

        <div class="monitor" id="m19">
            <div class="mon-id">M-19</div>
            <div class="mon-title">ᛉᛃᛦ — SENSOR ARRAY</div>
            <div class="data-line"><span class="data-key">LIDAR</span><span class="data-val shimmer">SCANNING</span></div>
            <div class="data-line"><span class="data-key">GRAVIMETRIC</span><span class="data-val shimmer">ACTIVE</span></div>
            <div class="data-line"><span class="data-key">THERMAL</span><span class="data-val shimmer">ACTIVE</span></div>
            <div class="data-line"><span class="data-key">EM PASSIVE</span><span class="data-val shimmer">LISTENING</span></div>
            <div class="data-line"><span class="data-key">RANGE</span><span class="data-val">4400 km</span></div>
            <div class="data-line"><span class="data-key">CONTACTS</span><span class="data-val" id="contactCount">6</span></div>
        </div>

        <div class="monitor" id="m20">
            <div class="mon-id">M-20</div>
            <div class="mon-title">꩜ — MASTER ALERT</div>
            <div class="tick" id="masterGlyph">꩜</div>
            <div style="font-size:10px;text-align:center;letter-spacing:2px;margin:4px 0" id="masterStatus">ALL SYSTEMS NOMINAL</div>
            <div class="data-line"><span class="data-key">ALERTS ACTIVE</span><span class="data-val" id="alertCount">0</span></div>
            <div class="data-line"><span class="data-key">SYSTEM TIME</span><span class="data-val" id="sysClock">--</span></div>
            <div class="btn-row">
                <button class="btn danger" onclick="redAlert()">꩜ RED ALERT</button>
                <button class="btn" onclick="clearAlerts()">ᚫ CLEAR</button>
            </div>
        </div>

        <div class="monitor" id="mAux">
            <div class="mon-id">AUX</div>
            <div class="mon-title">ᚹᚫᛞ — MISSION LOG</div>
            <div class="ai-line">ᛃ 00:00 — SYSTEMS BOOT COMPLETE</div>
            <div class="ai-line">ᚷ 00:01 — PLASMA ENG A+B NOMINAL</div>
            <div class="ai-line">ᛦ 00:02 — 2 HOSTILES DETECTED</div>
            <div class="ai-line shimmer" id="missionLatest">ᚩ 00:03 — MONITORING...</div>
            <div class="btn-row">
                <button class="btn" onclick="sendPrompt('Write the full C++ plasma engine detonation sequencer code for the Blood Fang frigate with microsecond precision timing and fault detection')">꩜ CODE ENGINE ↗</button>
            </div>
        </div>

    </div>

</div>

<script>
    const GLYPHS = ['꩜', 'ᚷ', 'ᛦ', 'ᚩ', 'ᛉ', 'ᚫ', 'ᛞ', 'ᚱ', 'ᚹ', 'ᛃ', 'ᚢ', 'ᚾ', 'ᛏ', 'ᛖ'];
    let alerts = 0;
    let t = 0;

    function clock() {
        const n = new Date();
        const s = String(n.getHours()).padStart(2, '0') + ':' + String(n.getMinutes()).padStart(2, '0') + ':' + String(n.getSeconds()).padStart(2, '0');
        document.getElementById('clock').textContent = s;
        document.getElementById('sysClock').textContent = s;
    }

    function rnd(a, b) { return Math.floor(Math.random() * (b - a + 1)) + a; }
    function rndF(a, b) { return (Math.random() * (b - a) + a).toFixed(1); }

    function fluctuate() {
        t++;
        const tA = rnd(65, 85); document.getElementById('thrustA').style.width = tA + '%'; document.getElementById('thrustAv').textContent = tA + '%';
        const pA = rnd(82, 95); document.getElementById('plasmaA').style.width = pA + '%'; document.getElementById('plasmaAv').textContent = pA + '%';
        const tmA = rnd(48, 70); document.getElementById('tempA').style.width = tmA + '%'; document.getElementById('tempAv').textContent = tmA + '%';
        document.getElementById('detA').textContent = rnd(820, 870);
        const tB = rnd(62, 78); document.getElementById('thrustB').style.width = tB + '%'; document.getElementById('thrustBv').textContent = tB + '%';
        const pB = rnd(85, 96); document.getElementById('plasmaB').style.width = pB + '%'; document.getElementById('plasmaBv').textContent = pB + '%';
        const tmB = rnd(55, 70); document.getElementById('tempB').style.width = tmB + '%'; document.getElementById('tempBv').textContent = tmB + '%';
        document.getElementById('detB').textContent = rnd(795, 830);
        document.getElementById('cap1').textContent = rnd(88, 98);
        document.getElementById('cap2').textContent = rnd(80, 95);
        document.getElementById('cap3').textContent = rnd(85, 97);
        document.getElementById('cap4').textContent = rnd(70, 88);
        document.getElementById('powerOut').textContent = rndF(13.5, 16.0);
        drawTactical();
        drawScanner();
        drawNav();
        animateFreq();
    }

    function drawTactical() {
        const c = document.getElementById('tacCanvas');
        const ctx = c.getContext('2d');
        const W = c.offsetWidth || 600, H = c.offsetHeight || 160;
        c.width = W; c.height = H;
        ctx.clearRect(0, 0, W, H);
        ctx.strokeStyle = '#1a0000'; ctx.lineWidth = 1;
        for (let x = 0; x < W; x += 30) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
        for (let y = 0; y < H; y += 20) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }
        const cx = W / 2, cy = H / 2;
        for (let r = 20; r < 100; r += 20) {
            ctx.strokeStyle = '#330000'; ctx.lineWidth = 0.5;
            ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.stroke();
        }
        ctx.strokeStyle = '#ff1a1a44'; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(cx, 0); ctx.lineTo(cx, H); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(0, cy); ctx.lineTo(W, cy); ctx.stroke();
        ctx.fillStyle = '#ff1a1a'; ctx.shadowBlur = 8; ctx.shadowColor = '#ff1a1a';
        ctx.font = 'bold 14px monospace'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText('꩜', cx, cy);
        ctx.shadowBlur = 0;
        const friends = [{ x: cx + 60 + Math.sin(t * 0.05) * 5, y: cy - 30, c: '#ffaa00', g: '◆' }, { x: cx - 80 + Math.cos(t * 0.04) * 4, y: cy + 20, c: '#ffaa00', g: '◆' }, { x: cx + 30, y: cy + 55, c: '#ffaa00', g: '◆' }];
        const foes = [{ x: cx + 140 + Math.sin(t * 0.07) * 8, y: cy - 10 + Math.cos(t * 0.06) * 6, c: '#ff4444', g: '▲' }, { x: cx - 110 + Math.cos(t * 0.05) * 6, y: cy - 40 + Math.sin(t * 0.08) * 5, c: '#ff4444', g: '▲' }];
        const unk = [{ x: cx + 180 + Math.sin(t * 0.03) * 12, y: cy + 30, c: '#aa00aa', g: '✦' }];
        [...friends, ...foes, ...unk].forEach(o => {
            ctx.fillStyle = o.c; ctx.shadowColor = o.c; ctx.shadowBlur = 6;
            ctx.font = '12px monospace'; ctx.textAlign = 'center';
            ctx.fillText(o.g, o.x, o.y);
        });
        ctx.shadowBlur = 0;
        ctx.strokeStyle = '#ff444433'; ctx.lineWidth = 1; ctx.setLineDash([3, 3]);
        foes.forEach(f => { ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(f.x, f.y); ctx.stroke(); });
        ctx.setLineDash([]);
    }

    function drawScanner() {
        const c = document.getElementById('scanCanvas');
        const ctx = c.getContext('2d');
        const W = c.width, H = c.height, cx = W / 2, cy = H / 2;
        ctx.clearRect(0, 0, W, H);
        ctx.strokeStyle = '#1a0000';
        for (let r = 15; r < 60; r += 15) { ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.lineWidth = 0.5; ctx.stroke(); }
        const sweep = (t * 0.08) % (Math.PI * 2);
        const grad = ctx.createConicalGradient ? null : null;
        ctx.strokeStyle = '#ff1a1a'; ctx.lineWidth = 1; ctx.shadowBlur = 4; ctx.shadowColor = '#ff1a1a';
        ctx.beginPath(); ctx.moveTo(cx, cy);
        ctx.lineTo(cx + Math.cos(sweep) * 58, cy + Math.sin(sweep) * 58); ctx.stroke();
        ctx.shadowBlur = 0;
        ctx.fillStyle = '#ff4444'; ctx.font = '10px monospace';
        ctx.fillText('▲', cx + 45, cy - 8); ctx.fillText('▲', cx - 42, cy - 25);
        ctx.fillStyle = '#aa00aa'; ctx.fillText('✦', cx + 65, cy + 18);
        ctx.fillStyle = '#ff1a1a'; ctx.fillText('꩜', cx - 4, cy + 4);
    }

    function drawNav() {
        const c = document.getElementById('navCanvas');
        const ctx = c.getContext('2d');
        const W = c.width, H = c.height, cx = W / 2, cy = H / 2;
        ctx.clearRect(0, 0, W, H);
        ctx.strokeStyle = '#330000'; ctx.lineWidth = 0.5;
        ctx.beginPath(); ctx.arc(cx, cy, 40, 0, Math.PI * 2); ctx.stroke();
        ctx.beginPath(); ctx.arc(cx, cy, 25, 0, Math.PI * 2); ctx.stroke();
        const a = (t * 0.02) % (Math.PI * 2);
        ctx.strokeStyle = '#ff1a1a'; ctx.lineWidth = 2; ctx.shadowBlur = 4; ctx.shadowColor = '#ff1a1a';
        ctx.beginPath(); ctx.moveTo(cx, cy);
        ctx.lineTo(cx + Math.cos(a) * 38, cy + Math.sin(a) * 38); ctx.stroke();
        ctx.shadowBlur = 0;
        ctx.fillStyle = '#ff1a1a'; ctx.font = '10px monospace'; ctx.textAlign = 'center';
        ctx.fillText('N', cx, cy - 44); ctx.fillText('S', cx, cy + 52);
        ctx.fillText('E', cx + 52, cy + 4); ctx.fillText('W', cx - 50, cy + 4);
        document.getElementById('heading').textContent = (47.3 + Math.sin(t * 0.01) * 0.5).toFixed(1) + '°';
    }

    function animateFreq() {
        const c = document.getElementById('freqBars');
        if (!c.children.length) {
            for (let i = 0; i < 28; i++) { const b = document.createElement('div'); b.className = 'freq-bar'; b.style.alignSelf = 'flex-end'; c.appendChild(b); }
        }
        Array.from(c.children).forEach(b => {
            const h = rnd(4, 28); b.style.height = h + 'px';
            b.style.background = h > 20 ? '#ff4444' : '#ff1a1a';
        });
    }

    const aiMessages = [
        'ᛃ THREAT CLASSIFICATION RUNNING...',
        'ᚩ WEAPONS LOCK CONFIRMED ON BOGEY-01',
        'ᚷ PLASMA SYNC A+B OPTIMAL',
        'ᛦ ECM SWEEP — NO INTRUSION',
        'ᚱ COURSE DEVIATION +0.002° CORRECTED',
        'ᚹ FLEET PING ACKNOWLEDGED',
        'ᛞ CREW VITALS NOMINAL ALL STATIONS',
        'ᛉ SENSOR SWEEP 4400km COMPLETE',
        'ᚫ AI WATCHDOG CYCLE OK',
        'ᚢ LIFE SUPPORT STABLE — O2 96%',
    ];
    let aiIdx = 0;
    function updateAI() {
        const log = document.getElementById('aiLog');
        const line = document.createElement('div');
        line.className = 'ai-line';
        if (aiIdx === aiMessages.length - 1) line.classList.add('thinking');
        line.textContent = aiMessages[aiIdx % aiMessages.length];
        log.insertBefore(line, log.firstChild);
        if (log.children.length > 5) log.removeChild(log.lastChild);
        aiIdx++;
    }

    const commsMessages = [
        { t: '00:00', m: 'FLEET: YCS-9 GHOST CLAW ONLINE', w: false },
        { t: '00:01', m: 'FLEET: PATROL SECTOR 7 CLEAR', w: false },
        { t: '00:02', m: '!! BOGEY-01 ENCRYPTED PROBE DETECTED', w: true },
        { t: '00:03', m: 'QKD REKEY COMPLETE — SECURE', w: false },
        { t: '00:04', m: 'YCS-11: WE HAVE VISUAL ON HOSTILE', w: false },
        { t: '00:05', m: '!! CHAOS ECM FRIGATE 1200km', w: true },
        { t: '00:06', m: 'FREQ HOP ENGAGED — SPECTRUM CLEAR', w: false },
    ];
    let commsIdx = 0;
    function updateComms() {
        const log = document.getElementById('commsLog');
        const entry = commsMessages[commsIdx % commsMessages.length];
        const div = document.createElement('div');
        div.className = 'log-entry';
        div.innerHTML = `<span class="log-time">${entry.t}</span><span class="log-msg${entry.w ? ' warn' : ''}">${entry.m}</span>`;
        log.insertBefore(div, log.firstChild);
        if (log.children.length > 5) log.removeChild(log.lastChild);
        commsIdx++;
    }

    function setMode(mode) {
        document.getElementById('shipMode').textContent = mode;
        const m5 = document.getElementById('m5');
        if (mode === 'COMBAT' || mode === 'FULL ASSAULT') {
            document.getElementById('threatLevel').textContent = 'HIGH';
            m5.classList.add('alert');
            document.getElementById('masterStatus').textContent = 'COMBAT MODE ENGAGED';
            addAlert();
        } else if (mode === 'STEALTH') {
            document.getElementById('threatLevel').textContent = 'LOW';
            m5.classList.remove('alert');
            document.getElementById('modeCloaking').classList.add('active');
        } else {
            document.getElementById('threatLevel').textContent = 'LOW';
            m5.classList.remove('alert');
            document.getElementById('masterStatus').textContent = 'ALL SYSTEMS NOMINAL';
        }
    }

    function addAlert() {
        alerts++;
        document.getElementById('alertCount').textContent = alerts;
        document.getElementById('masterGlyph').style.textShadow = '0 0 20px #ff0000';
    }

    function clearAlerts() {
        alerts = 0;
        document.getElementById('alertCount').textContent = 0;
        document.getElementById('masterStatus').textContent = 'ALL SYSTEMS NOMINAL';
        document.getElementById('masterGlyph').style.textShadow = '';
        document.getElementById('m5').classList.remove('alert');
        document.getElementById('threatLevel').textContent = 'LOW';
    }

    function redAlert() {
        setMode('FULL ASSAULT');
        document.getElementById('masterStatus').textContent = '!! RED ALERT !!';
        document.getElementById('ecmStatus').textContent = 'UNDER ATTACK';
        document.getElementById('jamDet').textContent = 'CHAOS ECM';
        document.getElementById('m7').classList.add('alert');
        addAlert();
    }

    function triggerECM() {
        document.getElementById('ecmStatus').textContent = 'COUNTER-JAM';
        setTimeout(() => { document.getElementById('ecmStatus').textContent = 'NOMINAL'; }, 2000);
    }

    function burnKeys() {
        document.getElementById('ecmStatus').textContent = 'REKEYING...';
        setTimeout(() => { document.getElementById('ecmStatus').textContent = 'NOMINAL'; }, 1500);
    }

    function broadcastAlert() {
        updateComms();
    }

    function boostEngine(e) {
        const el = document.getElementById('thrust' + e);
        el.style.width = '100%';
        document.getElementById('thrust' + e + 'v').textContent = 'MAX';
        setTimeout(() => { el.style.width = '75%'; document.getElementById('thrust' + e + 'v').textContent = '75%'; }, 1500);
    }

    function cutEngine(e) {
        const el = document.getElementById('thrust' + e);
        el.style.width = '10%';
        document.getElementById('thrust' + e + 'v').textContent = '10%';
    }

    function fireAll() {
        document.getElementById('masterStatus').textContent = 'WEAPONS FREE — FIRING';
        addAlert();
        setTimeout(() => { document.getElementById('masterStatus').textContent = 'VOLLEY COMPLETE'; }, 2000);
    }

    function safeWeapons() {
        document.getElementById('masterStatus').textContent = 'WEAPONS SAFED';
    }

    function deployRepair() {
        document.getElementById('masterStatus').textContent = 'REPAIR BOTS DEPLOYED';
    }

    function updateMissionLog() {
        const msgs = ['ᚩ MONITORING BOGEY-01...', 'ᛦ PLASMA SYNC OPTIMAL', 'ᚱ COURSE HOLDING', 'ᛉ SENSOR SWEEP OK', 'ᚹ FLEET COMMS NOMINAL', 'ᛞ ALL CREW VITAL'];
        document.getElementById('missionLatest').textContent = msgs[Math.floor(Math.random() * msgs.length)];
    }

    setInterval(clock, 1000);
    setInterval(fluctuate, 1200);
    setInterval(updateAI, 2500);
    setInterval(updateComms, 3500);
    setInterval(updateMissionLog, 4000);
    clock(); fluctuate(); updateAI(); updateComms(); animateFreq();
</script>
