@code {
    // ── Dependencies ─────────────────────────────────────────
    private NovaCortex _nova = default!;
    private List<(string sender, string text)> messages = new();
    private string userInput = "";
    private bool _sidebarOpen = false;
    private string _currentTime = "";
    private System.Threading.Timer? _clockTimer;

    // ── Emotion state ─────────────────────────────────────────
    private string _staticEmotionColor = "#39ff14";
    private string _staticEmotionEmoji  = "🔵";
    private string _staticEmotionState  = "calm";
    // ── Player identity — updated in Phase 1.b/1.c ────────────
    private string _playerPortrait = "male-bio-civilian.png";
    private string _playerClass = "CIVILIAN";
    private bool _showCharSelect = false;


    // ── Init ──────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        _currentTime = DateTime.Now.ToString("ddd MMM dd yyyy — hh:mm tt").ToUpper();
        _clockTimer = new System.Threading.Timer(_ =>
        {
            _currentTime = DateTime.Now.ToString("ddd MMM dd yyyy — hh:mm tt").ToUpper();
            InvokeAsync(StateHasChanged);
        }, null, 0, 30000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _nova = new NovaCortex(JS, Http);
            await _nova.LoadSession();
            await _nova.LoadAPIContent();
            StateHasChanged();
        }
    }
    private bool _crewOpen = false;
    private void ToggleCrewPanel() => _crewOpen = !_crewOpen;

    private record CrewMember(
        string Name, string Type, string SkillLine, string Image,
        int HP, int Armor, int Attack);

    private List<CrewMember> ParseCrew(List<string> raw)
    {
        var result = new List<CrewMember>();
        foreach (var entry in raw)
        {
            var p = entry.Split('|');
            if (p.Length >= 7)
                result.Add(new CrewMember(
                    p[0], p[1], p[2].Replace(",", "  "), p[3],
                    int.Parse(p[4]), int.Parse(p[5]), int.Parse(p[6])));
            else if (p.Length >= 4)
                // legacy entries from before this patch — fallback values
                result.Add(new CrewMember(p[0], p[1], p[2].Replace(",", "  "), p[3], 100, 0, 5));
        }
        return result;
    }
    // ── Send message ──────────────────────────────────────────
    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput)) return;
        var input = userInput;
        userInput = "";
        messages.Add(("You", input));
        StateHasChanged();
        await ScrollToBottom();

        var reply = await _nova.Respond(input);

        if (reply == "[OPEN_CHAR_SELECT]")
        {
            _showCharSelect = true;
            messages.Add(("Nova",
                "Opening operative registration. Choose your class, operative."));
        }
        else
        {
            messages.Add(("Nova", reply));
        }

        _staticEmotionColor = _nova.GetEmotionalColor();
        _staticEmotionState = _nova.GetEmotionalState();
        _staticEmotionEmoji = _nova.GetEmotionalEmoji();

        StateHasChanged();
        await ScrollToBottom();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessage();
    }

    // ── Auto scroll ───────────────────────────────────────────
    private async Task ScrollToBottom()
    {
        await JS.InvokeVoidAsync("eval", @"
        const feed = document.getElementById('novaFeed');
        if (feed) {
            feed.scrollTop = feed.scrollHeight;
        }
    ");
    }


    // ── Sidebar ───────────────────────────────────────────────
    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private async Task HandleCharSelect(
    NovaCharacterSelect.CharSelectResult result)
    {
        _showCharSelect = false;
        _playerClass = result.Class.ToUpper();
        _playerPortrait = result.Gender == "male" && result.Type == "biological"
            ? $"male-bio-{result.Class}.png"
            : "male-bio-civilian.png"; // fallback until other PNGs exist

        // Feed the class into Nova so she can react
        var reply = await _nova.Respond(
            $"[SYSTEM] Player selected: {result.Gender} {result.Type} {result.Class}");
        messages.Add(("Nova", reply));
        StateHasChanged();
        await ScrollToBottom();
    }
    // ── New Chat ──────────────────────────────────────────────
   private async Task NewChat()
{
    messages.Clear();

    // Full cortex reset — preserves nothing
    _nova = new NovaCortex(JS, Http);
    await _nova.LoadAPIContent();

    // Clear localStorage so HP/coins/rep start fresh
    await JS.InvokeVoidAsync(
        "localStorage.removeItem", "nova_session");

    _staticEmotionColor = "#39ff14";
    _staticEmotionState = "calm";
    _staticEmotionEmoji = "🔵";
    _sidebarOpen = false;
    StateHasChanged();
}
    private MarkupString FormatNovaBubble(string text)
    {
        text = text.Replace("[CHAPTER1_BANNER]",
            "<img src='/iAssets/chapter1-banner.png' class='chapter-banner-img' alt='Chapter 1' />");
        text = text.Replace("[CHAPTER2_BANNER]",
            "<img src='/iAssets/chapter2-banner.png' class='chapter-banner-img' alt='Chapter 2' />");

        // NEW: inline item/ship PNG rendering — [IMG:filename.png]
        text = System.Text.RegularExpressions.Regex.Replace(
            text, @"\[IMG:([a-zA-Z0-9\-_]+\.png)\]",
            m => $"<img src='/iAssets/{m.Groups[1].Value}' class='bubble-item-img' " +
                 $"alt='item' onerror=\"this.src='/iAssets/inventory-default.png'\" />");

        return new MarkupString(text);
    }

    private record InventorySlot(
    string Id, string Name, string Description,
    string Stat, string Image, string Category);

    private List<InventorySlot> ParseInventory(List<string> raw)
    {
        var result = new List<InventorySlot>();
        foreach (var entry in raw)
        {
            var p = entry.Split('|');
            if (p.Length >= 6)
                result.Add(new InventorySlot(p[0], p[1], p[2], p[3], p[4], p[5]));
            else
                // Legacy format fallback (plain string)
                result.Add(new InventorySlot("ITEM", entry, "", "", "inventory-default.png", "misc"));
        }
        return result;
    }

    private bool _playerInvOpen = false;
    private bool _novaInvOpen = false;
    private string? _hoveredItem = null;

    private void TogglePlayerInv() => _playerInvOpen = !_playerInvOpen;
    private void ToggleNovaInv() => _novaInvOpen = !_novaInvOpen;
    private void SetHover(string? item) => _hoveredItem = item;

    private string SlotBorderColor(string category) => category switch
    {
        "weapon" => "rgba(255,107,107,0.6)",
        "armor" => "rgba(100,180,255,0.6)",
        "consumable" => "rgba(57,255,20,0.6)",
        "upgrade" => "rgba(255,215,0,0.6)",
        _ => "rgba(90,138,170,0.4)",
    };


    // ── Cleanup ───────────────────────────────────────────────
    public void Dispose() => _clockTimer?.Dispose();
}
