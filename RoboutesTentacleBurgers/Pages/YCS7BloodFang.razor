
@page "/YCS7BloodFang"
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0
    }

    :root {
        --red: #ff1a1a;
        --red-dim: #990000;
        --red-glow: #ff1a1a44;
        --red-dark: #1a0000;
        --bg: #000;
        --panel: #0a0000;
        --panel2: #110000;
        --border: #330000;
        --border-bright: #660000;
        --font: 'Share Tech Mono',monospace;
    }

    body {
        background: var(--bg);
        color: var(--red);
        font-family: var(--font);
        font-size: 11px;
        overflow-x: hidden
    }

    .deck {
        display: grid;
        grid-template-columns: 1fr 2fr 1fr;
        grid-template-rows: auto auto auto;
        gap: 4px;
        padding: 4px;
        min-height: 100vh
    }

    .hdr {
        grid-column: 1/-1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--red-dim);
        padding: 4px 8px;
        background: var(--panel)
    }

    .hdr-title {
        font-size: 15px;
        letter-spacing: 3px;
        text-shadow: 0 0 8px var(--red)
    }

    .hdr-glyphs {
        font-size: 18px;
        letter-spacing: 6px;
        opacity: .7;
        filter: drop-shadow(0 0 4px var(--red))
    }

    .status-bar {
        display: flex;
        gap: 12px;
        font-size: 10px;
        color: var(--red-dim)
    }

        .status-bar span {
            color: var(--red)
        }

    .left-col {
        display: grid;
        grid-template-rows: repeat(4,1fr);
        gap: 4px
    }

    .center-col {
        display: grid;
        grid-template-rows: 2fr 1fr 1fr;
        gap: 4px
    }

    .right-col {
        display: grid;
        grid-template-rows: repeat(4,1fr);
        gap: 4px
    }

    .monitor {
        background: var(--panel);
        border: 1px solid var(--border-bright);
        padding: 6px;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        transition: border-color .2s
    }

        .monitor:hover {
            border-color: var(--red);
            box-shadow: 0 0 8px var(--red-glow) inset
        }

        .monitor.alert {
            border-color: var(--red);
            animation: pulse 1s infinite
        }

        .monitor.active {
            border-color: var(--red);
            box-shadow: 0 0 12px var(--red-glow) inset
        }
    @@keyframes pulse {
        0%, 100% {
            box-shadow: 0 0 4px var(--red-glow) inset
        }

        50% {
            box-shadow: 0 0 16px var(--red-glow) inset
        }
    }

    .mon-id {
        position: absolute;
        top: 3px;
        right: 5px;
        font-size: 9px;
        color: var(--red-dim);
        opacity: .6
    }

    .mon-title {
        font-size: 10px;
        letter-spacing: 2px;
        color: var(--red);
        margin-bottom: 4px;
        text-shadow: 0 0 4px var(--red)
    }

    .mon-glyph {
        font-size: 22px;
        line-height: 1;
        filter: drop-shadow(0 0 6px var(--red));
        margin-bottom: 2px
    }

    .glyph-label {
        font-size: 9px;
        color: var(--red-dim);
        letter-spacing: 1px
    }

    .bar-row {
        display: flex;
        align-items: center;
        gap: 4px;
        margin: 2px 0
    }

    .bar-label {
        font-size: 9px;
        color: var(--red-dim);
        width: 40px;
        flex-shrink: 0
    }

    .bar-track {
        flex: 1;
        height: 5px;
        background: var(--red-dark);
        border: 1px solid var(--border)
    }

    .bar-fill {
        height: 100%;
        background: var(--red);
        transition: width 1s
    }

    .bar-val {
        font-size: 9px;
        color: var(--red);
        width: 26px;
        text-align: right
    }

    .tactical {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 160px
    }

    canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%
    }

    .grid-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: repeating-linear-gradient(0deg,transparent,transparent 19px,#1a000033 20px), repeating-linear-gradient(90deg,transparent,transparent 19px,#1a000033 20px)
    }

    .data-line {
        display: flex;
        justify-content: space-between;
        font-size: 9px;
        margin: 1px 0
    }

    .data-val {
        color: var(--red)
    }

    .data-key {
        color: var(--red-dim)
    }

    .comms-log {
        overflow: hidden;
        max-height: 80px
    }

    .log-entry {
        font-size: 9px;
        padding: 1px 0;
        border-bottom: 1px solid var(--border);
        display: flex;
        gap: 6px;
        align-items: flex-start
    }

    .log-time {
        color: var(--red-dim);
        flex-shrink: 0
    }

    .log-msg {
        color: var(--red);
        opacity: .8
    }

        .log-msg.warn {
            opacity: 1;
            color: #ff4444
        }

    .freq-row {
        display: flex;
        gap: 2px;
        margin: 3px 0
    }

    .freq-bar {
        width: 4px;
        background: var(--red-dim);
        transition: height .3s;
        border-radius: 1px 1px 0 0
    }

    .btn-row {
        display: flex;
        gap: 3px;
        margin-top: 4px;
        flex-wrap: wrap
    }

    .btn {
        background: var(--red-dark);
        border: 1px solid var(--red-dim);
        color: var(--red);
        font-family: var(--font);
        font-size: 9px;
        padding: 2px 6px;
        cursor: pointer;
        letter-spacing: 1px;
        transition: all .15s
    }

        .btn:hover {
            background: var(--red-glow);
            border-color: var(--red);
            text-shadow: 0 0 4px var(--red)
        }

        .btn.danger {
            border-color: #ff0000;
            color: #ff0000
        }

    .ring-wrap {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 70px
    }

    svg.ring {
        overflow: visible
    }

    .plasma-chamber {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3px;
        margin: 4px 0
    }

    .chamber {
        background: var(--red-dark);
        border: 1px solid var(--red-dim);
        padding: 3px;
        text-align: center
    }

    .chamber-num {
        font-size: 16px;
        color: var(--red);
        text-shadow: 0 0 6px var(--red)
    }

    .chamber-lbl {
        font-size: 8px;
        color: var(--red-dim)
    }

    .scanner-wrap {
        position: relative;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center
    }

    .threat-list {
        font-size: 9px
    }

    .threat-row {
        display: flex;
        justify-content: space-between;
        padding: 1px 0;
        border-bottom: 1px solid var(--border)
    }

    .threat-id {
        color: var(--red)
    }

    .threat-dist {
        color: var(--red-dim)
    }

    .threat-status {
        color: #ff4444;
        font-size: 8px
    }

    .shimmer {
        animation: shimmer 2s infinite
    }
    @@keyframes shimmer {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .5
        }
    }

    .crew-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3px
    }

    .crew-card {
        background: var(--red-dark);
        border: 1px solid var(--border);
        padding: 3px
    }

    .crew-name {
        font-size: 9px;
        color: var(--red);
        letter-spacing: 1px
    }

    .crew-role {
        font-size: 8px;
        color: var(--red-dim)
    }

    .crew-vital {
        font-size: 8px;
        color: var(--red)
    }

    .ai-line {
        font-size: 9px;
        color: var(--red);
        padding: 1px 0;
        border-bottom: 1px solid var(--border)
    }

        .ai-line.thinking {
            opacity: .6;
            animation: shimmer 1.5s infinite
        }

    .alert-badge {
        position: absolute;
        top: 3px;
        left: 5px;
        background: var(--red);
        color: #000;
        font-size: 8px;
        padding: 1px 4px;
        letter-spacing: 1px
    }

    .mode-indicator {
        font-size: 9px;
        padding: 1px 6px;
        border: 1px solid var(--red-dim);
        color: var(--red-dim)
    }

        .mode-indicator.active {
            border-color: var(--red);
            color: var(--red);
            text-shadow: 0 0 4px var(--red)
        }

    .scrolling-glyph {
        font-size: 11px;
        opacity: .15;
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        overflow: hidden;
        white-space: nowrap;
        letter-spacing: 2px;
        pointer-events: none;
        animation: scroll-left 20s linear infinite
    }
    @@keyframes scroll-left {
        from {
            transform: translateX(100%)
        }

        to {
            transform: translateX(-100%)
        }
    }

    .nav-sphere {
        position: relative;
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center
    }

    .wep-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 2px 0;
        font-size: 9px
    }

    .wep-name {
        color: var(--red-dim)
    }

    .wep-status {
        padding: 1px 4px;
        font-size: 8px
    }

    .wep-ready {
        color: var(--red);
        border: 1px solid var(--red-dim)
    }

    .wep-charge {
        color: #ff4444;
        border: 1px solid #ff4444;
        animation: pulse 2s infinite
    }

    .tick {
        font-size: 18px;
        color: var(--red);
        text-align: center;
        text-shadow: 0 0 10px var(--red);
        font-weight: bold;
        letter-spacing: 4px;
        margin: 4px 0
    }
</style>

<div class="deck" id="deck">

    <div class="hdr">
        <div>
            <div class="hdr-glyphs" id="glyphHeader">꩜ ᚷ ᛦ ᚩ ᛉ ᚫ ꩜ ᛞ ᚱ</div>
            <div class="hdr-title">YCS-7 BLOOD FANG — COMMAND DECK ONLINE</div>
        </div>
        <div class="status-bar">
            <span>SHIP-TIME <span id="clock">00:00:00</span></span>
            <span>CREW <span>14/14</span></span>
            <span>HULL <span>97%</span></span>
            <span>THREAT <span id="threatLevel">LOW</span></span>
            <span>MODE <span id="shipMode">CRUISE</span></span>
        </div>
    </div>

    <div class="left-col">

        <div class="monitor" id="m1">
            <div class="mon-id">M-01</div>
            <div class="mon-title">ᚷᛦᚩ — PLASMA ENGINE A</div>
            <div class="mon-glyph">꩜</div>
            <div class="glyph-label">KETH-VAL :: THRUST CORE ALPHA</div>
            <div class="bar-row"><span class="bar-label">THRUST</span><div class="bar-track"><div class="bar-fill" id="thrustA" style="width:72%"></div></div><span class="bar-val" id="thrustAv">72%</span></div>
            <div class="bar-row"><span class="bar-label">PLASMA</span><div class="bar-track"><div class="bar-fill" id="plasmaA" style="width:88%"></div></div><span class="bar-val" id="plasmaAv">88%</span></div>
            <div class="bar-row"><span class="bar-label">TEMP</span><div class="bar-track"><div class="bar-fill" id="tempA" style="width:54%"></div></div><span class="bar-val" id="tempAv">54%</span></div>
            <div class="data-line"><span class="data-key">DETONATION/SEC</span><span class="data-val" id="detA">847</span></div>
            <div class="data-line"><span class="data-key">CHAMBER PSI</span><span class="data-val">4.2M</span></div>
            <div class="btn-row"><button class="btn" onclick="boostEngine('A')">ᛉ BOOST</button><button class="btn" onclick="cutEngine('A')">ᚫ CUT</button></div>
            <div class="scrolling-glyph">ᚷᛦᚩᛉᚫᛞᚱᚹᚷᛦᚩᛉᚫᛞᚱᚹᚷᛦᚩ</div>
        </div>

        <div class="monitor" id="m2">
            <div class="mon-id">M-02</div>
            <div class="mon-title">ᚹᚫᛞ — PLASMA ENGINE B</div>
            <div class="mon-glyph">ᛦ</div>
            <div class="glyph-label">VETH-KAL :: THRUST CORE BETA</div>
            <div class="bar-row"><span class="bar-label">THRUST</span><div class="bar-track"><div class="bar-fill" id="thrustB" style="width:69%"></div></div><span class="bar-val" id="thrustBv">69%</span></div>
            <div class="bar-row"><span class="bar-label">PLASMA</span><div class="bar-track"><div class="bar-fill" id="plasmaB" style="width:91%"></div></div><span class="bar-val" id="plasmaBv">91%</span></div>
            <div class="bar-row"><span class="bar-label">TEMP</span><div class="bar-track"><div class="bar-fill" id="tempB" style="width:61%"></div></div><span class="bar-val" id="tempBv">61%</span></div>
            <div class="data-line"><span class="data-key">DETONATION/SEC</span><span class="data-val" id="detB">812</span></div>
            <div class="data-line"><span class="data-key">CHAMBER PSI</span><span class="data-val">4.1M</span></div>
            <div class="btn-row"><button class="btn" onclick="boostEngine('B')">ᛉ BOOST</button><button class="btn" onclick="cutEngine('B')">ᚫ CUT</button></div>
            <div class="scrolling-glyph">ᚹᚫᛞᚱᚹᚫᛞᚱᚹᚫᛞᚱᚹᚫᛞᚱᚹᚫᛞ</div>
        </div>

        <div class="monitor" id="m3">
            <div class="mon-id">M-03</div>
            <div class="mon-title">ᚱᛃᚷ — POWER GRID</div>
            <div class="mon-glyph">ᛃ</div>
            <div class="glyph-label">RAK-JEL :: ELECTRICAL CORE</div>
            <div class="plasma-chamber">
                <div class="chamber"><div class="chamber-num" id="cap1">94</div><div class="chamber-lbl">CAP-1 %</div></div>
                <div class="chamber"><div class="chamber-num" id="cap2">87</div><div class="chamber-lbl">CAP-2 %</div></div>
                <div class="chamber"><div class="chamber-num" id="cap3">91</div><div class="chamber-lbl">CAP-3 %</div></div>
                <div class="chamber"><div class="chamber-num" id="cap4">78</div><div class="chamber-lbl">CAP-4 %</div></div>
            </div>
            <div class="data-line"><span class="data-key">OUTPUT GW</span><span class="data-val" id="powerOut">14.7</span></div>
            <div class="data-line"><span class="data-key">DRAW GW</span><span class="data-val">11.2</span></div>
            <div class="scrolling-glyph">ᚱᛃᚷᚩᛦᚱᛃᚷᚩᛦᚱᛃᚷᚩᛦᚱᛃᚷ</div>
        </div>

        <div class="monitor" id="m4">
            <div class="mon-id">M-04</div>
            <div class="mon-title">ᛏᚢᚾ — LIFE SUPPORT</div>
            <div class="mon-glyph">ᚢ</div>
            <div class="glyph-label">TUL-NAR :: BIOSPHERE CTRL</div>
            <div class="bar-row"><span class="bar-label">O2</span><div class="bar-track"><div class="bar-fill" style="width:96%"></div></div><span class="bar-val">96%</span></div>
            <div class="bar-row"><span class="bar-label">CO2</span><div class="bar-track"><div class="bar-fill" style="width:4%"></div></div><span class="bar-val">4%</span></div>
            <div class="bar-row"><span class="bar-label">PRESS</span><div class="bar-track"><div class="bar-fill" style="width:100%"></div></div><span class="bar-val">1atm</span></div>
            <div class="bar-row"><span class="bar-label">TEMP</span><div class="bar-track"><div class="bar-fill" style="width:68%"></div></div><span class="bar-val">21°C</span></div>
            <div class="data-line"><span class="data-key">RAD SHIELD</span><span class="data-val">ACTIVE</span></div>
            <div class="scrolling-glyph">ᛏᚢᚾᛃᚷᛏᚢᚾᛃᚷᛏᚢᚾᛃᚷᛏᚢᚾ</div>
        </div>

    </div>

    <div class="center-col">

        <div class="monitor active" id="m5">
            <div class="mon-id">M-05 / M-06</div>
            <div class="mon-title">ᛉᚫᛞᚱ — TACTICAL DISPLAY</div>
            <div class="tactical">
                <div class="grid-overlay"></div>
                <canvas id="tacCanvas" width="600" height="160"></canvas>
            </div>
            <div style="display:flex;gap:6px;margin-top:4px;flex-wrap:wrap">
                <span style="font-size:9px;color:var(--red)">● YCS-7 BLOOD FANG</span>
                <span style="font-size:9px;color:#ffaa00">◆ FRIENDLY x3</span>
                <span style="font-size:9px;color:#ff4444">▲ HOSTILE x2</span>
                <span style="font-size:9px;color:#aa00aa">✦ UNKNOWN x1</span>
            </div>
            <div class="btn-row">
                <button class="btn" onclick="setMode('CRUISE')">ᚷ CRUISE</button>
                <button class="btn" onclick="setMode('COMBAT')">ᛦ COMBAT</button>
                <button class="btn" onclick="setMode('STEALTH')">ᚩ STEALTH</button>
                <button class="btn danger" onclick="setMode('FULL ASSAULT')">꩜ ASSAULT</button>
            </div>
            <div class="scrolling-glyph">꩜ᛉᚫᛞᚱᚹᛃᚷᛦᚩᛉᚫᛞᚱᚹᛃᚷᛦᚩ꩜ᛉᚫᛞᚱᚹᛃᚷ</div>
        </div>

        <div class="monitor" id="m7">
            <div class="mon-id">M-07 / M-08</div>
            <div class="mon-title">ᚹᛃᚷ — COMMS / ECM DEFENSE</div>
            <div style="display:flex;gap:4px;height:calc(100% - 30px)">
                <div style="flex:1">
                    <div class="glyph-label">SIGNAL SPECTRUM</div>
                    <div class="freq-row" id="freqBars"></div>
                    <div class="data-line"><span class="data-key">FREQ HOP</span><span class="data-val shimmer">ACTIVE</span></div>
                    <div class="data-line"><span class="data-key">QKD KEY</span><span class="data-val">VALID</span></div>
                    <div class="data-line"><span class="data-key">ECM STATUS</span><span class="data-val" id="ecmStatus">NOMINAL</span></div>
                    <div class="data-line"><span class="data-key">JAMMING DET</span><span class="data-val" id="jamDet">NONE</span></div>
                    <div class="btn-row">
                        <button class="btn" onclick="triggerECM()">ᛉ COUNTER-JAM</button>
                        <button class="btn" onclick="burnKeys()">ᚫ BURN KEYS</button>
                    </div>
                </div>
                <div style="flex:1;border-left:1px solid var(--border);padding-left:6px">
                    <div class="glyph-label">FLEET COMMS LOG</div>
                    <div class="comms-log" id="commsLog"></div>
                    <div class="btn-row" style="margin-top:4px">
                        <button class="btn" onclick="broadcastAlert()">꩜ FLEET ALERT</button>
                    </div>
                </div>
            </div>
            <div class="scrolling-glyph">ᚹᛃᚷᚩᛦᚹᛃᚷᚩᛦᚹᛃᚷᚩᛦᚹᛃᚷᚩᛦ</div>
        </div>

        <div class="monitor" id="m9">
            <div class="mon-id">M-09 / M-10</div>
            <div class="mon-title">ᛞᚱᚹ — AI SHIP BRAIN</div>
            <div id="aiLog" style="max-height:90px;overflow:hidden"></div>
            <div style="display:flex;gap:4px;margin-top:4px;flex-wrap:wrap">
                <span class="mode-indicator active" id="modeNav">NAV</span>
                <span class="mode-indicator active" id="modeWeap">WEAP</span>
                <span class="mode-indicator" id="modeCloaking">CLOAK</span>
                <span class="mode-indicator active" id="modeEcm">ECM</span>
                <span class="mode-indicator" id="modeHunt">HUNT</span>
            </div>
            <div class="btn-row">
                <button class="btn" onclick="sendPrompt('Design the AI neural network architecture for my Yautja space frigate brain system — include threat classification, damage control, and fleet coordination modules')">꩜ DESIGN AI CORE ↗</button>
            </div>
            <div class="scrolling-glyph">ᛞᚱᚹᛏᚢᛞᚱᚹᛏᚢᛞᚱᚹᛏᚢᛞᚱᚹᛏᚢᛞ</div>
        </div>

    </div>

    <div class="right-col">

        <div class="monitor" id="m11">
            <div class="mon-id">M-11</div>
            <div class="mon-title">ᚩᛉᚫ — WEAPONS ARRAY</div>
            <div class="mon-glyph">ᚩ</div>
            <div class="glyph-label">OKH-ZEL :: ARMAMENT CTRL</div>
            <div class="wep-row"><span class="wep-name">PLASMA CANNON ×4</span><span class="wep-status wep-ready">READY</span></div>
            <div class="wep-row"><span class="wep-name">RAIL GUN ×2</span><span class="wep-status wep-ready">READY</span></div>
            <div class="wep-row"><span class="wep-name">MISSILE BAY ×16</span><span class="wep-status wep-ready">12 RDY</span></div>
            <div class="wep-row"><span class="wep-name">POINT DEF ×8</span><span class="wep-status wep-charge">CHARGING</span></div>
            <div class="wep-row"><span class="wep-name">CLOAKING MINE</span><span class="wep-status wep-ready">×6 RDY</span></div>
            <div class="btn-row">
                <button class="btn danger" onclick="fireAll()">꩜ FIRE ALL</button>
                <button class="btn" onclick="safeWeapons()">ᚫ SAFE</button>
            </div>
            <div class="scrolling-glyph">ᚩᛉᚫᛞᚱᚩᛉᚫᛞᚱᚩᛉᚫᛞᚱᚩᛉᚫᛞ</div>
        </div>

        <div class="monitor" id="m12">
            <div class="mon-id">M-12</div>
            <div class="mon-title">ᚫᛞᚱ — THREAT SCANNER</div>
            <div class="scanner-wrap">
                <canvas id="scanCanvas" width="120" height="80"></canvas>
            </div>
            <div class="threat-list" id="threatList">
