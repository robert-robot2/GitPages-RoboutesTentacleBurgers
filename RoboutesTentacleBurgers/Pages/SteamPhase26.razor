  <text x="700" y="88" text-anchor="middle" font-size="10" fill="#e8c060" font-family="Courier New" font-weight="700">100 GALLON PRESSURE VESSEL — SS 316L — FRONT MOUNT — MACK BERSERKER ENGINE BAY</text>
  <text x="700" y="104" text-anchor="middle" font-size="8" fill="#604010" font-family="Courier New">Dome faces all four sides · TIG fillet all interior corners · PRV array top · dual EWI injectors top center · steam manifold front face</text>

  <!-- Steam collection zone top -->
  <rect x="180" y="116" width="1040" height="80" rx="6" fill="#001808" stroke="#39ff14" stroke-width="1.5" opacity=".9"/>
  <ellipse cx="700" cy="156" rx="480" ry="35" fill="url(#sg26)" class="a-glow"/>
