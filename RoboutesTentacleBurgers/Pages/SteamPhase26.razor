  <text x="340" y="401" text-anchor="middle" font-size="7" fill="#ff4500" font-family="Courier New">HEATER ELEMENT × 1</text>
  <!-- Steam rise from bowl 1 -->
  <line x1="340" y1="305" x2="340" y2="200" stroke="#39ff14" stroke-width="1.5" stroke-dasharray="5,3" class="a-steam" marker-end="url(#as26)"/>

  <!-- Bowl 2 -->
  <ellipse cx="700" cy="380" rx="130" ry="38" fill="#0a0500" stroke="#b87333" stroke-width="2"/>
  <path d="M570 310 Q700 380 830 310" fill="#0a0300" stroke="#b87333" stroke-width="2.5"/>
  <text x="700" y="330" text-anchor="middle" font-size="9" fill="#b87333" font-family="Courier New" font-weight="700">BOWL 2</text>
