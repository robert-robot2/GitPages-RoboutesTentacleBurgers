<script>
  function toTimeStr(h) {
    const isPM5 = h < 24;
    let display;
    if (h < 12) display = h.toFixed(2).replace('.', ':').replace(/(\d+):(\d+)/, (m,hr,mn) => `${hr}:${String(Math.round(parseFloat('0.'+mn)*60)).padStart(2,'0')}AM`);
    else if (h < 13) display = '12:' + String(Math.round((h - Math.floor(h)) * 60)).padStart(2,'0') + 'PM';
    else if (h < 24) {
      const h12 = h - 12;
      const hrs = Math.floor(h12);
      const mins = Math.round((h12 - hrs) * 60);
      display = `${hrs}:${String(mins).padStart(2,'0')}PM`;
    } else {
      const h12 = h - 24;
      const hrs = Math.floor(h12);
      const mins = Math.round((h12 - hrs) * 60);
      display = `${hrs || 12}:${String(mins).padStart(2,'0')}AM`;
    }
    return display;
  }

  function formatHour(val) {
    // val is 0-30 range representing 3PM May5 to 1:45PM May6
    // 3PM = 15, midnight = 24, 1:45PM next day = 37.75
    const actual = val;
    return toTimeStr(actual);
  }

