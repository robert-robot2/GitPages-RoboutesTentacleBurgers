<script>
        (function(){
      const cv=document.getElementById('tentacle-title');
      if(!cv)return;
      const ctx=cv.getContext('2d');
      const dpr=devicePixelRatio||1;
      let W,H;
      function resize(){
        const r=cv.getBoundingClientRect();
        W=cv.width=r.width*dpr;
        H=cv.height=r.height*dpr;
      }
      resize();

      const tentacles=[];
      const COUNT=18;
      for(let i=0;i<COUNT;i++){
        const segs=[];
        for(let s=0;s<18;s++)segs.push({x:0,y:0});
        tentacles.push({
          baseX: 0.45 + (i/COUNT)*0.3,
          phase:Math.random()*Math.PI*2,
          phaseSpd:0.012+Math.random()*0.01,
          segs,
          len:(0.08+Math.random()*0.06),
        });
      }

      let t=0;
      function draw(){
        resize();
        ctx.clearRect(0,0,W,H);
        t+=0.016;

        tentacles.forEach(ten=>{
          ten.phase+=ten.phaseSpd;
          const bx=ten.baseX*W;
          const by=H*0.55;
          const totalLen=ten.len*W;
          const segLen=totalLen/ten.segs.length;

          ten.segs.forEach((seg,i)=>{
            const prog=i/ten.segs.length;
            const wave1=Math.sin(t*1.2+ten.phase+prog*3.5)*H*0.28*prog;
            const wave2=Math.sin(t*0.7+ten.phase*1.3+prog*2.2)*H*0.18*prog;
            seg.x=bx+Math.cos(ten.phase*0.4+prog*1.2)*segLen*i*0.9;
            seg.y=by+wave1+wave2;
          });

          ctx.beginPath();
          ctx.moveTo(ten.segs[0].x,ten.segs[0].y);
          for(let s=1;s<ten.segs.length-1;s++){
            const mx=(ten.segs[s].x+ten.segs[s+1].x)/2;
            const my=(ten.segs[s].y+ten.segs[s+1].y)/2;
            ctx.quadraticCurveTo(ten.segs[s].x,ten.segs[s].y,mx,my);
          }

          const prog_tip=ten.segs.length-1;
          ctx.lineTo(ten.segs[prog_tip].x,ten.segs[prog_tip].y);

          ctx.strokeStyle='rgba(255,255,255,0.85)';
          ctx.lineWidth=(2.5-(ten.baseX*1.2))*dpr;
          ctx.shadowColor='#ffffff';
          ctx.shadowBlur=10*dpr;
          ctx.lineCap='round';
          ctx.lineJoin='round';
          ctx.stroke();
          ctx.shadowBlur=0;
        });

        requestAnimationFrame(draw);
      }
      draw();
    })();






</script>




<canvas id="nova" style="position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:0;pointer-events:none;"></canvas>
<script>
(function(){
'use strict';

if(window.HalloweenOverlay&&window.HalloweenOverlay.destroy){try{window.HalloweenOverlay.destroy();}catch(e){}}
if(window.ThanksgivingOverlay&&window.ThanksgivingOverlay.destroy){try{window.ThanksgivingOverlay.destroy();}catch(e){}}
const cv=document.getElementById('nova');
if(!cv)return;
const ctx=cv.getContext('2d');

/* ───────────── CONFIG ───────────── */
const TOP_OFFSET=58;   // height of your header bar (string lights, leaf garlands, acorns & honey drips hang from here)
const TAU=Math.PI*2;
const calm=!!(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches);

/* ───────────── STATE / HELPERS ───────────── */
let dpr=1,W=0,H=0,groundY=0,time=0,dt=0,running=false,raf=0,last=null;
const rnd=(a,b)=>a+Math.random()*(b-a);
const pick=a=>a[Math.floor(Math.random()*a.length)];
const N=n=>Math.max(1,Math.round(n*((W<700||calm)?0.5:1)));
const mouse={x:-9999,y:-9999,active:false};
const C={orange:[255,140,20],gold:[255,196,70],red:[210,50,30],green:[140,200,60],cream:[255,240,200],white:[255,255,255],yellow:[255,222,100],brown:[170,100,45]};
const leafCols=['#d9531e','#e8891c','#c23a1a','#f0b429','#a8481a','#8a9a2a'];

/* ───────────── GLOW SPRITES (cached) ───────────── */
const glowCache={};
function glowSprite(c){
  const k=c.join(',');
  if(glowCache[k])return glowCache[k];
  const s=document.createElement('canvas');s.width=s.height=64;
  const g=s.getContext('2d');
  const gr=g.createRadialGradient(32,32,0,32,32,32);
  gr.addColorStop(0,'rgba('+k+',1)');
  gr.addColorStop(0.25,'rgba('+k+',0.55)');
  gr.addColorStop(0.6,'rgba('+k+',0.14)');
  gr.addColorStop(1,'rgba('+k+',0)');
  g.fillStyle=gr;g.fillRect(0,0,64,64);
  glowCache[k]=s;return s;
}
function glow(c,x,y,size,alpha){
  if(alpha<=0)return;
  ctx.save();
  ctx.globalCompositeOperation='lighter';
  ctx.globalAlpha=Math.min(1,alpha);
  ctx.drawImage(glowSprite(c),x-size,y-size,size*2,size*2);
  ctx.restore();
}
let fogSprites=[];
function makeFog(rgbStr){
  const s=document.createElement('canvas');s.width=256;s.height=128;
  const g=s.getContext('2d');
  const gr=g.createRadialGradient(128,64,0,128,64,128);
  gr.addColorStop(0,'rgba('+rgbStr+',0.85)');
  gr.addColorStop(0.5,'rgba('+rgbStr+',0.3)');
  gr.addColorStop(1,'rgba('+rgbStr+',0)');
  g.fillStyle=gr;g.fillRect(0,0,256,128);
  return s;
}

/* ───────────── SHAPE HELPERS (take a context so sprites can reuse them) ───────────── */
function leafShape(g,s,col){
  g.fillStyle=col;g.beginPath();g.moveTo(0,-s);
  g.quadraticCurveTo(s*0.8,-s*0.4,0,s*0.7);
  g.quadraticCurveTo(-s*0.8,-s*0.4,0,-s);g.fill();
  g.strokeStyle='rgba(60,25,0,0.5)';g.lineWidth=1;
  g.beginPath();g.moveTo(0,-s);g.lineTo(0,s*0.95);g.stroke();
}
function drawAcorn(g,x,y,s){
  g.save();g.translate(x,y);
  g.fillStyle='#c98a3a';g.beginPath();g.ellipse(0,s*0.15,s*0.36,s*0.5,0,0,TAU);g.fill();
  g.fillStyle='#6b4220';g.beginPath();g.ellipse(0,-s*0.12,s*0.46,s*0.32,0,Math.PI,0);g.closePath();g.fill();
  g.fillRect(-s*0.04,-s*0.58,s*0.08,s*0.16);
  g.restore();
}
function drawCorn(g,x,y,s,rot){
  g.save();g.translate(x,y);g.rotate(rot);
  g.fillStyle='#f4c430';g.beginPath();g.ellipse(0,0,s*0.2,s*0.5,0,0,TAU);g.fill();
  g.strokeStyle='rgba(150,100,0,0.55)';g.lineWidth=Math.max(0.6,s*0.02);
  for(let i=-2;i<=2;i++){g.beginPath();g.moveTo(i*s*0.07,-s*0.45);g.lineTo(i*s*0.07,s*0.45);g.stroke();}
  for(let j=-3;j<=3;j++){g.beginPath();g.moveTo(-s*0.18,j*s*0.13);g.lineTo(s*0.18,j*s*0.13);g.stroke();}
  g.fillStyle='#6a9a2a';
  for(const sd of [-1,1]){g.beginPath();g.moveTo(0,s*0.5);g.quadraticCurveTo(sd*s*0.38,s*0.15,sd*s*0.2,-s*0.12);g.quadraticCurveTo(sd*s*0.1,s*0.2,0,s*0.5);g.closePath();g.fill();}
  g.restore();
}
function drawPie(g,x,y,s){
  g.fillStyle='#e6e1d8';g.beginPath();g.ellipse(x,y-2,s*1.1,s*0.2,0,0,TAU);g.fill();
  g.fillStyle='#d99a3c';g.beginPath();g.ellipse(x,y-s*0.3,s*0.95,s*0.42,0,Math.PI,0);g.lineTo(x+s*0.95,y-s*0.15);g.lineTo(x-s*0.95,y-s*0.15);g.closePath();g.fill();
  g.strokeStyle='rgba(120,60,10,0.6)';g.lineWidth=1.3;
  for(let i=-2;i<=2;i++){g.beginPath();g.moveTo(x+i*s*0.3-s*0.2,y-s*0.65);g.lineTo(x+i*s*0.3+s*0.2,y-s*0.15);g.stroke();}
}
function drawRoast(g,x,y,s){
  g.fillStyle='#cfd3dc';g.beginPath();g.ellipse(x,y-2,s*0.9,s*0.14,0,0,TAU);g.fill();
  const b=g.createRadialGradient(x-s*0.2,y-s*0.45,2,x,y-s*0.3,s*0.6);b.addColorStop(0,'#eeaa55');b.addColorStop(1,'#8a4414');
  g.fillStyle=b;g.beginPath();g.ellipse(x,y-s*0.3,s*0.55,s*0.32,0,0,TAU);g.fill();
  for(const sd of [-1,1]){
    g.fillStyle='#b8661f';g.beginPath();g.ellipse(x+sd*s*0.52,y-s*0.2,s*0.2,s*0.12,sd*-0.6,0,TAU);g.fill();
    g.fillStyle='#f4ecd8';g.beginPath();g.arc(x+sd*s*0.72,y-s*0.3,s*0.06,0,TAU);g.fill();
    g.fillStyle='#c0262d';g.beginPath();g.arc(x+sd*s*0.8,y-s*0.08,s*0.07,0,TAU);g.fill();
  }
}

/* ───────────── STATIC SPRITES (farm scene, leaf corners) ───────────── */
let farmSprite=null,farmY=0,cornerSprite=null,cornerSize=0;
const tables=[];

function drawTable(g,x,gl,w){
  const ty=gl-38,ex=x-w/2,top=ty-4;
  g.fillStyle='#2a170a';g.fillRect(ex+10,ty,8,44);g.fillRect(ex+w-18,ty,8,44);
  g.fillStyle='#a8322a';g.fillRect(ex,top,w,10);
  g.beginPath();g.moveTo(ex,ty+6);
  const k=8,sw=w/k;
  for(let i=0;i<k;i++)g.quadraticCurveTo(ex+i*sw+sw/2,ty+22,ex+(i+1)*sw,ty+6);
  g.closePath();g.fill();
  g.fillStyle='rgba(255,215,130,0.35)';g.fillRect(ex,ty+1,w,3);
  drawCorn(g,x-w*0.4,top-14,30,-0.5);
  drawCorn(g,x-w*0.31,top-12,28,0.35);
  drawRoast(g,x,top,34);
  drawPie(g,x+w*0.3,top,15);
  drawCorn(g,x+w*0.42,top-13,28,0.6);
  for(const sd of [-1,1]){
    const cx=x+sd*w*0.2;
    g.fillStyle='#f3e6c4';g.fillRect(cx-2,top-18,4,18);
    tables.push({x:cx,y:top-22,ph:rnd(0,TAU)});
  }
}

function buildFarm(){
  const gh=Math.round(Math.min(240,H*0.34));
  farmY=H-gh;
  const c=document.createElement('canvas');
  c.width=Math.max(1,Math.floor(W*dpr));c.height=Math.max(1,Math.floor(gh*dpr));
  const g=c.getContext('2d');g.scale(dpr,dpr);
  const gl=groundY-farmY;
  tables.length=0;
  g.lineCap='round';

  // autumn trees
  const th=Math.min(110,gl*0.55),cr=Math.min(40,gl*0.26);
  const treeXs=W>900?[0.06,0.4,0.66,0.94]:[0.08,0.9];
  for(const f of treeXs){
    const tx=W*f+rnd(-30,30);
    g.strokeStyle='#3a2210';g.lineWidth=11;
    g.beginPath();g.moveTo(tx,gl+3);g.lineTo(tx+rnd(-6,6),gl-th);g.stroke();
    g.lineWidth=5;g.beginPath();g.moveTo(tx,gl-th*0.5);g.lineTo(tx-cr*0.9,gl-th-cr*0.4);g.moveTo(tx,gl-th*0.6);g.lineTo(tx+cr*0.9,gl-th-cr*0.5);g.stroke();
    for(let i=0;i<34;i++){
      const a=rnd(0,TAU),d=rnd(0,cr*1.5);
      g.globalAlpha=rnd(0.55,0.9);g.fillStyle=pick(leafCols);
      g.beginPath();g.arc(tx+Math.cos(a)*d*1.3,gl-th-cr*0.4+Math.sin(a)*d*0.8,rnd(8,16),0,TAU);g.fill();
    }
    g.globalAlpha=1;
  }

  // ground
  const gg=g.createLinearGradient(0,gl,0,gh);
  gg.addColorStop(0,'#2e1c0e');gg.addColorStop(1,'#0d0603');
  g.fillStyle=gg;
  g.beginPath();g.moveTo(0,gh);g.lineTo(0,gl+4);
  for(let x=0;x<=W+40;x+=40)g.lineTo(x,gl+4+Math.sin(x*0.035)*3);
  g.lineTo(W,gh);g.closePath();g.fill();
  g.strokeStyle='rgba(255,190,90,0.32)';g.lineWidth=1.5;
  g.beginPath();
  for(let x=0;x<=W+40;x+=40){const yy=gl+4+Math.sin(x*0.035)*3;if(x===0)g.moveTo(x,yy);else g.lineTo(x,yy);}
  g.stroke();

  // feast tables (corn, roast turkey, pie, candles)
  const tn=Math.max(1,Math.floor(W/560));
  for(let i=0;i<tn;i++)drawTable(g,(i+0.5)*(W/tn)+rnd(-30,30),gl,rnd(160,190));

  // hay bales
  const hn=Math.floor(W/260);
  for(let i=0;i<hn;i++){
    const x=(i+0.5)*(W/hn)+rnd(-60,60),w=rnd(40,56),h=rnd(30,38);
    g.fillStyle='#d4a73a';g.strokeStyle='rgba(90,55,10,0.7)';g.lineWidth=1.2;
    g.beginPath();g.rect(x-w/2,gl+6-h,w,h);g.fill();g.stroke();
    g.strokeStyle='rgba(120,80,20,0.6)';
    for(let k=1;k<4;k++){g.beginPath();g.moveTo(x-w/2+k*w/4,gl+6-h);g.lineTo(x-w/2+k*w/4,gl+6);g.stroke();}
    g.strokeStyle='#f0d070';g.beginPath();g.moveTo(x-w/2,gl+6-h);g.lineTo(x-w/2-6,gl+2-h);g.moveTo(x+w/2,gl+6-h);g.lineTo(x+w/2+6,gl+3-h);g.stroke();
  }
  farmSprite=c;
}

function buildCorner(){
  cornerSize=Math.round(Math.min(280,Math.max(110,W*0.24)));
  const c=document.createElement('canvas');
  c.width=Math.floor(cornerSize*dpr);c.height=Math.floor(cornerSize*dpr);
  const g=c.getContext('2d');g.scale(dpr,dpr);
  const S=cornerSize;
  g.strokeStyle='#5a3515';g.lineWidth=3;g.lineCap='round';
  g.beginPath();g.moveTo(0,S*0.05);g.quadraticCurveTo(S*0.5,S*0.12,S*0.9,S*0.55);g.stroke();
  g.beginPath();g.moveTo(S*0.05,0);g.quadraticCurveTo(S*0.15,S*0.5,S*0.5,S*0.9);g.stroke();
  for(let i=0;i<36;i++){
    const x=Math.pow(Math.random(),1.7)*S,y=Math.pow(Math.random(),1.7)*(S-x*0.7);
    g.save();g.translate(x,y);g.rotate(rnd(0,TAU));leafShape(g,rnd(9,17),pick(leafCols));g.restore();
  }
  cornerSprite=c;
}

function layout(){
  const de=document.documentElement;
  W=de.clientWidth||window.innerWidth;H=window.innerHeight;
  dpr=Math.min(window.devicePixelRatio||1,2);
  cv.style.width=W+'px';cv.style.height=H+'px';
  cv.width=Math.floor(W*dpr);cv.height=Math.floor(H*dpr);
  groundY=H-Math.max(34,Math.min(70,H*0.07));
  buildFarm();buildCorner();
}

/* ═════════════════════ ENTITIES ═════════════════════ */

/* ── stars ── */
const stars=[];
function initStars(){
  stars.length=0;
  for(let i=0;i<N(110);i++)stars.push({x:Math.random(),y:Math.random()*0.8,r:rnd(0.4,1.4),ph:rnd(0,TAU),sp:rnd(0.8,2.4),col:pick(['255,240,210','255,220,170','255,200,150'])});
}
function drawStars(){
  for(const s of stars){
    const a=0.25+0.45*(0.5+0.5*Math.sin(time*s.sp+s.ph));
    ctx.fillStyle='rgba('+s.col+','+a+')';
    ctx.beginPath();ctx.arc(s.x*W,s.y*H,s.r,0,TAU);ctx.fill();
  }
}

/* ── harvest moon ── */
const craters=[[-0.3,-0.2,0.2],[0.25,0.1,0.26],[-0.1,0.4,0.15],[0.4,-0.35,0.12],[-0.45,0.2,0.1]];
function drawMoon(){
  const r=Math.max(46,Math.min(110,Math.min(W,H)*0.11));
  const mx=W*0.8,my=Math.max(r+TOP_OFFSET+30,H*0.22);
  const pulse=0.85+0.15*Math.sin(time*0.7);
  glow(C.gold,mx,my,r*3.8,0.38*pulse);
  glow(C.orange,mx,my,r*2.3,0.2*pulse);
  const g=ctx.createRadialGradient(mx-r*0.3,my-r*0.3,r*0.1,mx,my,r);
  g.addColorStop(0,'#fff1c4');g.addColorStop(0.55,'#ffc65a');g.addColorStop(1,'#e8862a');
  ctx.fillStyle=g;ctx.beginPath();ctx.arc(mx,my,r,0,TAU);ctx.fill();
  ctx.fillStyle='rgba(160,90,20,0.25)';
  for(const c of craters){ctx.beginPath();ctx.arc(mx+c[0]*r,my+c[1]*r,c[2]*r,0,TAU);ctx.fill();}
}

/* ── shooting stars (replaces lightning) ── */
const shoot={active:false,next:rnd(3,6),t:0,dur:1,x:0,y:0,vx:0,vy:0};
function updateShoot(){
  if(!shoot.active){
    shoot.next-=dt;
    if(shoot.next<=0){
      shoot.active=true;shoot.t=0;shoot.dur=rnd(0.8,1.3);
      shoot.x=rnd(0.1,0.9)*W;shoot.y=rnd(TOP_OFFSET+20,H*0.3);
      const a=rnd(0.3,0.7),sp=rnd(500,800);
      shoot.vx=Math.cos(a)*sp*(Math.random()<0.5?1:-1);shoot.vy=Math.sin(a)*sp;
    }
  }else{
    shoot.t+=dt;shoot.x+=shoot.vx*dt;shoot.y+=shoot.vy*dt;
    if(shoot.t>=shoot.dur){shoot.active=false;shoot.next=rnd(6,12);}
  }
}
function drawShoot(){
  if(!shoot.active)return;
  const k=1-shoot.t/shoot.dur,tx=shoot.x-shoot.vx*0.2,ty=shoot.y-shoot.vy*0.2;
  const g=ctx.createLinearGradient(shoot.x,shoot.y,tx,ty);
  g.addColorStop(0,'rgba(255,240,190,'+k+')');g.addColorStop(1,'rgba(255,170,60,0)');
  ctx.strokeStyle=g;ctx.lineWidth=3;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(shoot.x,shoot.y);ctx.lineTo(tx,ty);ctx.stroke();
  glow(C.gold,shoot.x,shoot.y,20,k);
}

/* ── birds (replace bats) ── */
const birds=[];
function newBird(init){
  const dir=Math.random()<0.5?1:-1;
  return {x:init?rnd(0,W):(dir>0?-80:W+80),by:rnd(TOP_OFFSET+30,Math.max(TOP_OFFSET+70,H*0.6)),dir:dir,sp:rnd(50,120),s:rnd(9,18),ph:rnd(0,TAU),fl:rnd(6,10),amp:rnd(15,50),fr:rnd(0.8,1.6)};
}
function initBirds(){birds.length=0;for(let i=0;i<N(7);i++)birds.push(newBird(true));}
function drawBird(x,y,s,f,dir){
  ctx.save();ctx.translate(x,y);ctx.scale(dir,1);ctx.lineCap='round';ctx.lineJoin='round';
  for(let pass=0;pass<2;pass++){
    ctx.strokeStyle=pass===0?'rgba(255,190,110,0.5)':'#1a0e08';
    ctx.lineWidth=pass===0?Math.max(3,s*0.28):Math.max(1.6,s*0.14);
    ctx.beginPath();ctx.moveTo(-s,-f*s*0.7);
    ctx.quadraticCurveTo(-s*0.4,-f*s*0.5-s*0.25,0,0);
    ctx.quadraticCurveTo(s*0.4,-f*s*0.5-s*0.25,s,-f*s*0.7);ctx.stroke();
  }
  ctx.restore();
}
function drawBirds(){
  for(let i=0;i<birds.length;i++){
    const b=birds[i];
    b.x+=b.dir*b.sp*dt;b.ph+=dt;
    if((b.dir>0&&b.x>W+100)||(b.dir<0&&b.x<-100))birds[i]=newBird(false);
    drawBird(b.x,b.by+Math.sin(b.ph*b.fr)*b.amp,b.s,Math.sin(time*b.fl+b.ph),b.dir);
  }
}

/* ── falling leaves & acorns (replace bones) ── */
const fall=[];
function newFall(init){return {x:rnd(0,W),y:init?rnd(0,H):rnd(-80,-20),vy:rnd(24,60),vx:rnd(-14,14),rot:rnd(0,TAU),vr:rnd(-2,2),s:rnd(9,18),acorn:Math.random()<0.15,ph:rnd(0,TAU),a:rnd(0.7,0.95),col:pick(leafCols)};}
function initFall(){fall.length=0;for(let i=0;i<N(26);i++)fall.push(newFall(true));}
function drawFall(){
  for(let i=0;i<fall.length;i++){
    const b=fall[i];
    b.y+=b.vy*dt;b.x+=(b.vx+Math.sin(time*1.3+b.ph)*22)*dt;b.rot+=b.vr*dt;
    if(mouse.active){ // leaf gust
      const dx=b.x-mouse.x,dy=b.y-mouse.y,d=Math.hypot(dx,dy);
      if(d<140&&d>1){const f=(1-d/140)*160*dt;b.x+=dx/d*f;b.y+=dy/d*f;}
    }
    if(b.y>H+40)fall[i]=newFall(false);
    ctx.save();ctx.translate(b.x,b.y);ctx.globalAlpha=b.a;
    if(b.acorn){ctx.rotate(Math.sin(time*0.8+b.ph)*0.5);drawAcorn(ctx,0,0,b.s*1.2);}
    else{ctx.rotate(b.rot);ctx.scale(1,0.35+0.65*Math.abs(Math.cos(time*1.6+b.ph)));leafShape(ctx,b.s,b.col);}
    ctx.restore();
  }
  ctx.globalAlpha=1;
}

/* ── feathers ── */
const feathers=[];
const fCols=['#8a4a1c','#c0391b','#e8891c','#f0b429','#f6e3a0'];
function spawnFeather(x,y,burst){
  if(feathers.length>160)return;
  const a=rnd(0,TAU),sp=burst?rnd(60,260):rnd(10,60);
  feathers.push({x:x,y:y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-(burst?90:10),rot:rnd(0,TAU),vr:rnd(-5,5),life:rnd(2.5,4.5),s:rnd(10,20),col:pick(fCols),ph:rnd(0,TAU)});
}
function drawFeathers(){
  for(let i=feathers.length-1;i>=0;i--){
    const f=feathers[i];
    f.life-=dt;
    if(f.life<=0){feathers.splice(i,1);continue;}
    f.vx*=1-Math.min(1,dt*1.5);f.vy+=(35-f.vy)*Math.min(1,dt*2);
    f.x+=(f.vx+Math.sin(time*3+f.ph)*25)*dt;f.y+=f.vy*dt;f.rot+=f.vr*dt*0.6;
    ctx.save();ctx.translate(f.x,f.y);ctx.rotate(f.rot);ctx.globalAlpha=Math.min(1,f.life);
    ctx.fillStyle=f.col;ctx.beginPath();ctx.ellipse(0,0,f.s*0.2,f.s*0.5,0,0,TAU);ctx.fill();
    ctx.strokeStyle='rgba(60,25,0,0.6)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(0,-f.s*0.5);ctx.lineTo(0,f.s*0.75);ctx.stroke();
    ctx.restore();
  }
  ctx.globalAlpha=1;
}

/* ═════ TURKEY (used by the brawlers AND the flying ones) ═════ */
const tPal=[['#6b3a1a','#c0391b','#f0b429'],['#5a3216','#e8891c','#f6e3a0'],['#7a4420','#a8301f','#e8b13a']];
function drawTurkey(x,y,s,dir,o){
  const pal=tPal[o.pal||0],by=-s*0.5;
  ctx.save();ctx.translate(x,y);if(o.rot)ctx.rotate(o.rot);ctx.scale(dir,1);ctx.lineCap='round';ctx.lineJoin='round';
  if(!o.fly){ctx.fillStyle='rgba(0,0,0,0.4)';ctx.beginPath();ctx.ellipse(0,1,s*0.34,s*0.05,0,0,TAU);ctx.fill();}
  // tail fan
  const n=9,spread=1.5+o.fan*0.9,ctr=-Math.PI/2-0.45;
  ctx.save();ctx.translate(-s*0.2,by-s*0.02);
  for(let i=0;i<n;i++){
    const a=ctr+(i/(n-1)-0.5)*spread,L=s*(0.58+0.12*Math.sin(i*0.9+o.fan*2)+o.fan*0.12),w=s*0.075;
    ctx.save();ctx.rotate(a);
    ctx.fillStyle=pal[0];ctx.beginPath();ctx.ellipse(L*0.5,0,L*0.5,w,0,0,TAU);ctx.fill();
    ctx.fillStyle=pal[1];ctx.beginPath();ctx.ellipse(L*0.66,0,L*0.32,w*0.78,0,0,TAU);ctx.fill();
    ctx.fillStyle=pal[2];ctx.beginPath();ctx.ellipse(L*0.86,0,L*0.13,w*0.5,0,0,TAU);ctx.fill();
    ctx.restore();
  }
  ctx.restore();
  // legs
  ctx.strokeStyle='#d9a03a';ctx.lineWidth=Math.max(2,s*0.035);
  for(const sd of [-1,1]){
    if(o.fly){ctx.beginPath();ctx.moveTo(sd*s*0.05,by+s*0.2);ctx.lineTo(sd*s*0.08,by+s*0.34);ctx.stroke();}
    else{const sw=Math.sin((o.walk||0)+(sd>0?0:Math.PI))*s*0.1;ctx.beginPath();ctx.moveTo(sd*s*0.04,by+s*0.18);ctx.lineTo(sd*s*0.02+sw,-s*0.03);ctx.lineTo(sd*s*0.02+sw+s*0.07,-s*0.01);ctx.stroke();}
  }
  // body
  const bg=ctx.createRadialGradient(s*0.05,by-s*0.08,s*0.04,0,by,s*0.34);bg.addColorStop(0,'#a06a35');bg.addColorStop(1,pal[0]);
  ctx.fillStyle=bg;ctx.strokeStyle='rgba(255,190,110,0.4)';ctx.lineWidth=1;
  ctx.beginPath();ctx.ellipse(0,by,s*0.31,s*0.25,-0.1,0,TAU);ctx.fill();ctx.stroke();
  // wing
  ctx.save();ctx.translate(-s*0.04,by+s*0.01);ctx.rotate(o.wing||0);if(o.fly)ctx.scale(1.5,1.5);
  ctx.fillStyle='#4a2610';ctx.beginPath();ctx.ellipse(-s*0.06,0,s*0.2,s*0.11,0.15,0,TAU);ctx.fill();
  ctx.strokeStyle=pal[2];ctx.lineWidth=Math.max(1,s*0.015);
  for(let i=-1;i<=1;i++){ctx.beginPath();ctx.moveTo(-s*0.22,i*s*0.035);ctx.lineTo(0,i*s*0.035);ctx.stroke();}
  ctx.restore();
  // neck + head
  const hx=s*0.3+(o.lunge||0)*s*0.12,hy=by-s*0.36+(o.bob||0)*s*0.03,bo=(o.beak||0)*s*0.04;
  ctx.strokeStyle='#d98a78';ctx.lineWidth=s*0.1;
  ctx.beginPath();ctx.moveTo(s*0.18,by-s*0.08);ctx.quadraticCurveTo(s*0.3,by-s*0.2,hx,hy);ctx.stroke();
  ctx.fillStyle='#78b0d4';ctx.beginPath();ctx.arc(hx,hy,s*0.085,0,TAU);ctx.fill();
  ctx.fillStyle='#f2b630';
  ctx.beginPath();ctx.moveTo(hx+s*0.07,hy-s*0.035-bo*0.3);ctx.lineTo(hx+s*0.19,hy-s*0.005-bo*0.3);ctx.lineTo(hx+s*0.07,hy+s*0.01);ctx.closePath();ctx.fill();
  ctx.beginPath();ctx.moveTo(hx+s*0.07,hy+s*0.01);ctx.lineTo(hx+s*0.17,hy+s*0.02+bo);ctx.lineTo(hx+s*0.06,hy+s*0.04+bo*0.5);ctx.closePath();ctx.fill();
  ctx.fillStyle='#d8262c';ctx.beginPath();ctx.ellipse(hx+s*0.08,hy+s*0.08+bo,s*0.03,s*0.07,0.1,0,TAU);ctx.fill();
  ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(hx+s*0.03,hy-s*0.02,s*0.028,0,TAU);ctx.fill();
  ctx.fillStyle='#111';ctx.beginPath();ctx.arc(hx+s*0.04,hy-s*0.02,s*0.014,0,TAU);ctx.fill();
  if(!o.fly){ctx.strokeStyle='#111';ctx.lineWidth=Math.max(1.5,s*0.015);ctx.beginPath();ctx.moveTo(hx-s*0.015,hy-s*0.075);ctx.lineTo(hx+s*0.07,hy-s*0.035);ctx.stroke();}
  // holiday hats
  if(o.hat===1){
    ctx.fillStyle='#16110f';ctx.strokeStyle='rgba(255,200,120,0.6)';ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(hx-s*0.075,hy-s*0.07);ctx.lineTo(hx-s*0.055,hy-s*0.2);ctx.lineTo(hx+s*0.055,hy-s*0.2);ctx.lineTo(hx+s*0.075,hy-s*0.07);ctx.closePath();ctx.fill();ctx.stroke();
    ctx.fillRect(hx-s*0.12,hy-s*0.08,s*0.24,s*0.025);
    ctx.fillStyle='#f0b429';ctx.fillRect(hx-s*0.06,hy-s*0.1,s*0.12,s*0.022);
  }else if(o.hat===2){
    ctx.fillStyle='#fdfbf4';
    ctx.beginPath();ctx.arc(hx,hy-s*0.16,s*0.07,0,TAU);ctx.arc(hx-s*0.06,hy-s*0.12,s*0.05,0,TAU);ctx.arc(hx+s*0.06,hy-s*0.12,s*0.05,0,TAU);ctx.fill();
    ctx.fillRect(hx-s*0.065,hy-s*0.12,s*0.13,s*0.045);
  }
  ctx.restore();
}

/* ── brawling turkeys ── */
const duels=[];
function initDuels(){
  duels.length=0;
  const sc=H<600?0.8:1;
  for(let i=0;i<N(3);i++)duels.push({cx:rnd(0.15,0.85)*W,s:rnd(88,116)*sc,yo:rnd(-4,10),d:150,st:0,t:rnd(1,3),ph:rnd(0,TAU),dr:rnd(-6,6),hit:0,pal:i%3,hats:[pick([0,1,2]),pick([0,1,2])]});
}
function startBrawl(u){
  u.st=1;u.t=1.5;u.hit=0;
  pop(u.cx,groundY-u.s*1.15,pick(['BAWK!','GOBBLE!!','BRAWL!','\uD83D\uDCA5','CLUCK!']));
}
function drawDuels(){
  for(const u of duels){
    u.t-=dt;u.ph+=dt;u.cx+=u.dr*dt;
    if(u.cx>W+100)u.cx=-100;if(u.cx<-100)u.cx=W+100;
    let jA=0,jB=0,fan=0.4,wing=0.2,beak=0,lunge=0,walk=u.ph*8;
    if(mouse.active&&u.st===0&&Math.hypot(mouse.x-u.cx,mouse.y-(groundY-u.s*0.5))<170)startBrawl(u);
    if(u.st===0){ // strut toward each other
      u.d+=(70-u.d)*Math.min(1,dt*0.9);
      fan=0.7+0.3*Math.sin(u.ph*3);
      if(u.t<=0||u.d<82)startBrawl(u);
    }else if(u.st===1){ // brawl!
      u.d=44+Math.abs(Math.sin(u.t*14))*26;
      jA=Math.abs(Math.sin(u.t*7))*u.s*0.25;jB=Math.abs(Math.sin(u.t*7+1.5))*u.s*0.25;
      fan=1;wing=Math.sin(u.t*30)*0.9;beak=Math.abs(Math.sin(u.t*10));lunge=1;
      u.hit-=dt;
      if(u.hit<=0){
        u.hit=0.18;
        for(let i=0;i<3;i++)spawnFeather(u.cx+rnd(-20,20),groundY-u.s*0.5-rnd(0,u.s*0.3),true);
        if(Math.random()<0.25)pop(u.cx,groundY-u.s*1.1,pick(['BAWK!','GOBBLE!','CLUCK!!','\uD83E\uDEB6']));
      }
      if(u.t<=0){u.st=2;u.t=1.2;}
    }else{ // recoil
      u.d+=(190-u.d)*Math.min(1,dt*2.2);
      fan=0.9;wing=Math.sin(u.ph*6)*0.3;
      if(u.t<=0){u.st=0;u.t=rnd(2.5,4);}
    }
    const gy=groundY+u.yo,bob=Math.sin(u.ph*6);
    drawTurkey(u.cx-u.d,gy-jA,u.s,1,{fan:fan,wing:wing,beak:beak,lunge:lunge,walk:walk,bob:bob,hat:u.hats[0],pal:u.pal});
    drawTurkey(u.cx+u.d,gy-jB,u.s,-1,{fan:fan,wing:-wing,beak:beak,lunge:lunge,walk:walk+1,bob:-bob,hat:u.hats[1],pal:(u.pal+1)%3});
  }
}

/* ── flying turkeys (replace ghosts; flee from the mouse) ── */
const flyers=[];
function initFlyers(){
  flyers.length=0;
  for(let i=0;i<N(5);i++){
    const bv=rnd(14,40)*(Math.random()<0.5?-1:1);
    flyers.push({x:rnd(0,W),y:rnd(TOP_OFFSET+60,Math.max(TOP_OFFSET+120,groundY-130)),s:rnd(60,92),vx:bv,bvx:bv,vy:0,t:rnd(0,TAU),pal:i%3,hat:[1,2,0][i%3],scared:0});
  }
}
function drawFlyers(){
  for(const g of flyers){
    g.t+=dt;
    g.vx+=(g.bvx-g.vx)*0.6*dt;g.vy+=(0-g.vy)*0.9*dt;
    g.scared=Math.max(0,g.scared-dt*0.8);
    if(mouse.active){
      const dx=g.x-mouse.x,dy=g.y-mouse.y,d=Math.hypot(dx,dy);
      if(d<180&&d>1){const f=(1-d/180);g.vx+=dx/d*420*f*dt;g.vy+=dy/d*420*f*dt;g.scared=Math.min(1,g.scared+f*dt*4);}
    }
    if(g.scared>0.5&&Math.random()<dt*6)spawnFeather(g.x,g.y-g.s*0.5,false);
    g.x+=g.vx*dt;g.y+=g.vy*dt+Math.sin(g.t*1.3)*14*dt;
    const ymin=TOP_OFFSET+50+g.s*0.5,ymax=groundY-60;
    if(g.y<ymin){g.y=ymin;g.vy=Math.abs(g.vy)*0.5;}
    if(g.y>ymax){g.y=ymax;g.vy=-Math.abs(g.vy)*0.5;}
    if(g.x>W+g.s)g.x=-g.s;if(g.x<-g.s)g.x=W+g.s;
    glow(C.gold,g.x,g.y-g.s*0.5,g.s*0.9,0.28);
    drawTurkey(g.x,g.y,g.s,g.vx>=0?1:-1,{fan:0.6+g.scared*0.4,wing:Math.sin(g.t*(7+g.scared*10))*0.9-0.4,fly:true,beak:g.scared,pal:g.pal,hat:g.hat,rot:Math.sin(g.t*0.8)*0.1+g.vy*0.002,bob:Math.sin(g.t*3)});
  }
}

/* ── hanging acorns on strings (replace spiders) ── */
const hangers=[];
function initHangers(){
  hangers.length=0;
  for(let i=0;i<N(5);i++)hangers.push({x:rnd(0.06,0.94)*W,len:rnd(50,200),tgt:rnd(50,250),tt:rnd(1,5),s:rnd(14,24),ph:rnd(0,TAU)});
}
function drawHangers(){
  const y0=TOP_OFFSET-4;
  for(const h of hangers){
    h.tt-=dt;
    if(h.tt<=0){h.tgt=rnd(40,Math.min(H*0.55,300));h.tt=rnd(3,8);}
    const sy=y0+h.len+Math.sin(time*1.5+h.ph)*3;
    let scared=false;
    if(mouse.active&&Math.hypot(mouse.x-h.x,mouse.y-sy)<140){h.tgt=20;h.tt=3;scared=true;}
    h.len+=(h.tgt-h.len)*Math.min(1,dt*(scared?5:0.8));
    ctx.save();ctx.translate(h.x,y0);ctx.rotate(Math.sin(time*1.4+h.ph)*0.1*(scared?3:1));
    ctx.strokeStyle='rgba(235,210,160,0.6)';ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(0,h.len-h.s*0.5);ctx.stroke();
    ctx.save();ctx.translate(h.s*0.3,h.len-h.s*0.5);ctx.rotate(0.9);leafShape(ctx,h.s*0.5,pick(leafCols));ctx.restore();
    drawAcorn(ctx,0,h.len,h.s);
    ctx.restore();
  }
}

/* ── corn stalks sprouting from the dirt (replace zombie hands) ── */
const stalks=[];
function initStalks(){
  stalks.length=0;
  for(let i=0;i<N(8);i++)stalks.push({x:rnd(0.03,0.97)*W,st:0,t:rnd(0,6),hmax:rnd(70,130),sway:rnd(0,TAU)});
}
function drawStalks(){
  const baseY=groundY+8;
  for(const h of stalks){
    h.t-=dt;
    let p=0;
    if(h.st===0){if(h.t<=0){h.st=1;h.t=1.1;h.x=rnd(0.03,0.97)*W;}}
    else if(h.st===1){p=1-Math.max(0,h.t)/1.1;if(h.t<=0){h.st=2;h.t=rnd(3,6);}}
    else if(h.st===2){p=1;if(h.t<=0){h.st=3;h.t=0.9;}}
    else{p=Math.max(0,h.t)/0.9;if(h.t<=0){h.st=0;h.t=rnd(2,8);}}
    if(p<=0.01)continue;
    const e=p*p*(3-2*p),ht=h.hmax*e,sx=Math.sin(time*1.6+h.sway)*7*e;
    const tipX=h.x+sx,tipY=baseY-ht;
    ctx.lineCap='round';
    ctx.strokeStyle='#8fb53a';ctx.lineWidth=6;
    ctx.beginPath();ctx.moveTo(h.x,baseY);ctx.quadraticCurveTo(h.x+sx*0.2,baseY-ht*0.5,tipX,tipY);ctx.stroke();
    ctx.strokeStyle='#6f9a2a';ctx.lineWidth=3.5;
    for(let i=0;i<4;i++){
      const f=0.25+i*0.18,px=h.x+sx*f*f,py=baseY-ht*f,sd=i%2?1:-1,L=ht*0.42;
      ctx.beginPath();ctx.moveTo(px,py);ctx.quadraticCurveTo(px+sd*L*0.7,py-L*0.35+Math.sin(time*2+i+h.sway)*3,px+sd*L,py+L*0.35);ctx.stroke();
    }
    if(e>0.6)drawCorn(ctx,h.x+sx*0.4+8,baseY-ht*0.6,ht*0.28,0.3);
    ctx.strokeStyle='#d6b24a';ctx.lineWidth=1.5;
    for(let i=-1;i<=1;i++){ctx.beginPath();ctx.moveTo(tipX,tipY);ctx.lineTo(tipX+i*6,tipY-12*e);ctx.stroke();}
    ctx.fillStyle='#120a05';ctx.beginPath();ctx.ellipse(h.x,baseY,16,6,0,0,TAU);ctx.fill();
  }
}

/* ── pumpkins, corn & pies ── */
function flicker(ph){
  const f=0.8+0.2*Math.sin(time*7+ph)*Math.sin(time*3.1+ph*2);
  return Math.max(0.55,Math.min(1,f));
}
function drawPumpkin(x,y,r,flick,rot){
  glow(C.orange,x,y,r*2.4,0.4*flick);
  ctx.save();ctx.translate(x,y);ctx.rotate(rot);
  const bg=ctx.createRadialGradient(-r*0.2,-r*0.3,r*0.1,0,0,r*1.1);
  bg.addColorStop(0,'#ffb03a');bg.addColorStop(0.6,'#f47a12');bg.addColorStop(1,'#b8470a');
  ctx.fillStyle=bg;ctx.strokeStyle='rgba(100,30,0,0.55)';ctx.lineWidth=Math.max(1,r*0.04);
  const lobes=[[-0.55,0.55],[0.55,0.55],[-0.28,0.72],[0.28,0.72],[0,0.78]];
  for(const l of lobes){ctx.beginPath();ctx.ellipse(l[0]*r,0,l[1]*r,r*0.82,0,0,TAU);ctx.fill();ctx.stroke();}
  ctx.fillStyle='#4b5d1e';
  ctx.beginPath();ctx.moveTo(-r*0.08,-r*0.72);ctx.quadraticCurveTo(-r*0.1,-r*1.0,r*0.08,-r*1.1);
  ctx.lineTo(r*0.2,-r*1.05);ctx.quadraticCurveTo(r*0.08,-r*0.95,r*0.12,-r*0.72);ctx.closePath();ctx.fill();
  ctx.save();ctx.translate(r*0.28,-r*0.95);ctx.rotate(0.8);leafShape(ctx,r*0.28,'#5f8a22');ctx.restore();
  ctx.strokeStyle='#6f9a2a';ctx.lineWidth=2;
  ctx.beginPath();ctx.moveTo(r*0.1,-r*1.0);ctx.bezierCurveTo(r*0.5,-r*1.25,r*0.75,-r*0.85,r*0.5,-r*0.8);ctx.stroke();
  ctx.fillStyle='rgba(255,230,170,0.25)';ctx.beginPath();ctx.ellipse(-r*0.4,-r*0.3,r*0.15,r*0.3,0.4,0,TAU);ctx.fill();
  ctx.restore();
}
const floats=[];
function initFloaters(){
  floats.length=0;
  for(let i=0;i<N(6);i++)floats.push({x:rnd(0,W),by:rnd(TOP_OFFSET+90,Math.max(TOP_OFFSET+130,groundY-130)),r:rnd(22,42),kind:i%3,ph:rnd(0,TAU),vx:rnd(-10,10)});
}
function drawFloaters(){
  for(const p of floats){
    p.x+=p.vx*dt;
    if(p.x>W+80)p.x=-80;if(p.x<-80)p.x=W+80;
    const y=p.by+Math.sin(time*0.9+p.ph)*14,rot=Math.sin(time*0.7+p.ph)*0.12,fl=flicker(p.ph);
    if(p.kind===0)drawPumpkin(p.x,y,p.r,fl,rot);
    else{
      glow(C.gold,p.x,y,p.r*2,0.35*fl);
      if(p.kind===1)drawCorn(ctx,p.x,y,p.r*2.2,rot*2+0.5);
      else drawPie(ctx,p.x,y+p.r*0.4,p.r*0.95);
    }
  }
}
const gpumps=[];
function initGroundPumpkins(){
  gpumps.length=0;
  const fr=W<700?[0.2,0.55,0.85]:[0.1,0.33,0.6,0.88];
  fr.forEach(function(f){gpumps.push({fx:f+rnd(-0.03,0.03),r:rnd(26,40),ph:rnd(0,TAU)});});
}
function drawGroundPumpkins(){
  for(const p of gpumps)drawPumpkin(p.fx*W,groundY-p.r*0.72,p.r,flicker(p.ph),0);
}
function drawCandles(){
  for(const c of tables){
    const fl=flicker(c.ph);
    glow(C.gold,c.x,c.y,26,0.7*fl);
    ctx.fillStyle='#ffd66a';ctx.beginPath();ctx.ellipse(c.x,c.y+2,2,4.5*fl+1,0,0,TAU);ctx.fill();
  }
}

/* ── warm mist ── */
const fogs=[];
function initFog(){
  fogSprites=[makeFog('255,170,90'),makeFog('255,215,150')];
  fogs.length=0;
  for(let i=0;i<N(8);i++)fogs.push({x:rnd(-200,W),y:groundY-rnd(10,70),w:rnd(380,700),h:rnd(90,170),v:rnd(6,20)*(Math.random()<0.5?-1:1),a:rnd(0.1,0.2),front:i%2===1,spr:i%4===3?1:0});
}
function drawFog(front){
  for(const f of fogs){
    if(f.front!==front)continue;
    f.x+=f.v*dt;
    if(f.v>0&&f.x>W+50)f.x=-f.w;
    if(f.v<0&&f.x<-f.w-50)f.x=W+50;
    ctx.globalAlpha=f.a*(front?0.8:1);
    ctx.drawImage(fogSprites[f.spr],f.x,f.y-f.h/2,f.w,f.h);
  }
  ctx.globalAlpha=1;
}

/* ── embers (floating lights) ── */
const wisps=[];
function newWisp(init){
  return {x:rnd(0,W),y:init?rnd(0,H):H+20,vy:rnd(8,30),ph:rnd(0,TAU),sz:rnd(6,16),col:pick([C.orange,C.orange,C.gold,C.red,C.yellow]),sp:rnd(0.6,1.8)};
}
function initWisps(){wisps.length=0;for(let i=0;i<N(55);i++)wisps.push(newWisp(true));}
function drawWisps(){
  for(let i=0;i<wisps.length;i++){
    const w=wisps[i];
    w.y-=w.vy*dt;w.ph+=dt*w.sp;
    if(w.y<-30)wisps[i]=newWisp(false);
    const x=w.x+Math.sin(w.ph)*26,a=0.5+0.4*Math.sin(w.ph*2.3);
    glow(w.col,x,w.y,w.sz*2.2,a*0.55);
    glow(C.white,x,w.y,w.sz*0.5,a*0.6);
  }
}

/* ── string lights ── */
const bulbCols=[C.orange,C.gold,C.red,C.green];
function drawLights(){
  const n=Math.max(1,Math.round(W/260)),sw=W/n,y0=TOP_OFFSET,sag=26,per=6;
  ctx.strokeStyle='rgba(40,25,12,0.9)';ctx.lineWidth=1.5;
  ctx.beginPath();
  for(let i=0;i<n;i++){ctx.moveTo(i*sw,y0);ctx.quadraticCurveTo(i*sw+sw/2,y0+sag*2,(i+1)*sw,y0);}
  ctx.stroke();
  for(let i=0;i<n;i++){
    const x0=i*sw,x1=(i+1)*sw,cx=x0+sw/2,cy=y0+sag*2;
    for(let k=1;k<=per;k++){
      const t=k/(per+1),u=1-t;
      const x=u*u*x0+2*u*t*cx+t*t*x1,y=u*u*y0+2*u*t*cy+t*t*y0;
      const idx=i*per+k,col=bulbCols[idx%4];
      const chase=(Math.floor(time*2)%4===idx%4)?0.35:0;
      const on=Math.min(1,0.55+0.3*Math.sin(time*3+idx*1.7)+chase);
      ctx.fillStyle='rgb('+Math.round(col[0]*on)+','+Math.round(col[1]*on)+','+Math.round(col[2]*on)+')';
      ctx.beginPath();ctx.ellipse(x,y+7,3.5,5.5,0,0,TAU);ctx.fill();
      ctx.fillStyle='#2a1a0c';ctx.fillRect(x-2,y,4,3);
      glow(col,x,y+7,24,on*0.85);
    }
  }
}

/* ── leaf garland corners (replace webs) ── */
function drawCorners(){
  if(!cornerSprite)return;
  const wy=TOP_OFFSET-4;
  ctx.drawImage(cornerSprite,0,wy,cornerSize,cornerSize);
  ctx.save();ctx.translate(W,0);ctx.scale(-1,1);ctx.drawImage(cornerSprite,0,wy,cornerSize,cornerSize);ctx.restore();
}

/* ── honey dripping from the top rail ── */
const topDrips=[];
function newTopDrip(wait){return {x:rnd(0.02,0.98)*W,len:0,max:rnd(40,170),sp:rnd(14,36),w:rnd(3,6),st:wait?3:0,hold:0,a:1,fy:0,wt:rnd(0.3,5)};}
function initTopDrips(){topDrips.length=0;for(let i=0;i<N(10);i++)topDrips.push(newTopDrip(true));}
function drawTopDrips(){
  const y0=TOP_OFFSET-4;
  for(let i=0;i<topDrips.length;i++){
    const d=topDrips[i];
    if(d.st===3){d.wt-=dt;if(d.wt<=0)d.st=0;continue;}
    if(d.st===0){d.len+=d.sp*dt*(1.1-d.len/d.max*0.8);if(d.len>=d.max*0.97){d.st=1;d.hold=rnd(2,5);}}
    else if(d.st===1){d.hold-=dt;if(d.hold<=0)d.st=2;}
    else{d.a-=dt*1.1;d.fy+=260*dt;if(d.a<=0){topDrips[i]=newTopDrip(true);continue;}}
    ctx.globalAlpha=d.a*0.92;
    ctx.strokeStyle='#c8780c';ctx.fillStyle='#c8780c';ctx.lineWidth=d.w;ctx.lineCap='round';
    ctx.beginPath();ctx.moveTo(d.x,y0);ctx.lineTo(d.x,y0+d.len);ctx.stroke();
    const bw=d.w*(0.95+(d.st===1?0.12*Math.sin(time*6+i):0));
    ctx.beginPath();ctx.arc(d.x,y0+d.len+d.fy,bw,0,TAU);ctx.fill();
    ctx.fillStyle='rgba(255,235,160,0.55)';ctx.beginPath();ctx.arc(d.x-bw*0.3,y0+d.len+d.fy-bw*0.3,bw*0.3,0,TAU);ctx.fill();
  }
  ctx.globalAlpha=1;
}

/* ── gravy & cranberry splatter ── */
const splats=[];
const splatPals=[['#4e2c0e','#7a4a1a','#5e3512'],['#5c0a1c','#9a1530','#7a0e24']];
let nextSplat=2;
function makeSplat(x,y,scale){
  const br=rnd(10,22)*scale,drops=[];
  const n=Math.floor(rnd(14,26)*Math.min(1.5,scale));
  for(let i=0;i<n;i++){
    const a=rnd(0,TAU),d=br*rnd(0.9,3.4);
    drops.push({a:a,d:d,r:Math.max(1,rnd(1.5,5)*scale*(1-d/(br*4))),streak:Math.random()<0.4});
  }
  const drips=[];
  const nd=Math.floor(rnd(1,4));
  for(let i=0;i<nd;i++)drips.push({dx:rnd(-br*0.6,br*0.6),len:0,max:rnd(30,110)*scale,sp:rnd(12,30),w:rnd(2,4.5)*Math.min(1.3,scale)});
  splats.push({x:x,y:y,age:0,life:rnd(11,16),br:br,drops:drops,drips:drips,pal:pick(splatPals)});
  if(splats.length>16)splats.shift();
}
function drawSplats(){
  for(let i=splats.length-1;i>=0;i--){
    const sp=splats[i],P=sp.pal;
    sp.age+=dt;
    if(sp.age>=sp.life){splats.splice(i,1);continue;}
    const a=Math.min(1,sp.age*6)*Math.min(1,(sp.life-sp.age)/3.5);
    ctx.save();ctx.translate(sp.x,sp.y);ctx.globalAlpha=a*0.92;ctx.lineCap='round';
    ctx.fillStyle=P[0];
    ctx.beginPath();ctx.arc(0,0,sp.br,0,TAU);
    for(let k=0;k<5;k++){const ka=k*1.26+sp.br;ctx.moveTo(Math.cos(ka)*sp.br*0.8+sp.br*0.5,Math.sin(ka)*sp.br*0.8);ctx.arc(Math.cos(ka)*sp.br*0.8,Math.sin(ka)*sp.br*0.8,sp.br*0.5,0,TAU);}
    ctx.fill();
    ctx.fillStyle=P[1];ctx.beginPath();ctx.arc(0,0,sp.br*0.7,0,TAU);ctx.fill();
    for(const d of sp.drops){
      const cx=Math.cos(d.a)*d.d,cy=Math.sin(d.a)*d.d;
      if(d.streak){
        ctx.strokeStyle=P[2];ctx.lineWidth=d.r*1.1;
        ctx.beginPath();ctx.moveTo(Math.cos(d.a)*sp.br*0.5,Math.sin(d.a)*sp.br*0.5);ctx.lineTo(cx,cy);ctx.stroke();
      }
      ctx.fillStyle=P[2];ctx.beginPath();ctx.arc(cx,cy,d.r,0,TAU);ctx.fill();
    }
    ctx.strokeStyle=P[2];ctx.fillStyle=P[2];
    for(const dr of sp.drips){
      if(dr.len<dr.max)dr.len+=dr.sp*dt*(1.2-dr.len/dr.max);
      ctx.lineWidth=dr.w;
      ctx.beginPath();ctx.moveTo(dr.dx,sp.br*0.4);ctx.lineTo(dr.dx,sp.br*0.4+dr.len);ctx.stroke();
      ctx.beginPath();ctx.arc(dr.dx,sp.br*0.4+dr.len,dr.w*0.8,0,TAU);ctx.fill();
    }
    ctx.fillStyle='rgba(255,210,170,0.35)';
    ctx.beginPath();ctx.ellipse(-sp.br*0.25,-sp.br*0.25,sp.br*0.35,sp.br*0.2,-0.6,0,TAU);ctx.fill();
    ctx.restore();
  }
  ctx.globalAlpha=1;
  nextSplat-=dt;
  if(nextSplat<=0){
    makeSplat(rnd(0.05,0.95)*W,rnd(0.15,0.85)*H,rnd(0.7,1.2));
    nextSplat=rnd(3.5,7);
  }
}

/* ── mouse sparks + pop text ── */
const sparks=[];
function spawnSpark(x,y,burst){
  if(sparks.length>220)return;
  const a=rnd(0,TAU),sp=burst?rnd(40,220):rnd(10,50);
  sparks.push({x:x,y:y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-(burst?40:10),life:rnd(0.5,1.2),col:pick([C.orange,C.gold,C.yellow,C.green]),sz:rnd(4,10)});
}
function drawSparks(){
  for(let i=sparks.length-1;i>=0;i--){
    const s=sparks[i];
    s.life-=dt;
    if(s.life<=0){sparks.splice(i,1);continue;}
    s.x+=s.vx*dt;s.y+=s.vy*dt;s.vy+=50*dt;s.vx*=0.98;
    const a=Math.min(1,s.life*1.5);
    glow(s.col,s.x,s.y,s.sz*1.8,a*0.8);
    glow(C.white,s.x,s.y,s.sz*0.4,a);
  }
}
const pops=[];
function pop(x,y,txt){pops.push({x:x,y:y,t:0,txt:txt,sz:rnd(22,34),vx:rnd(-20,20)});}
function drawPops(){
  for(let i=pops.length-1;i>=0;i--){
    const p=pops[i];
    p.t+=dt;p.y-=45*dt;p.x+=p.vx*dt;
    const a=1-p.t/1.6;
    if(a<=0){pops.splice(i,1);continue;}
    ctx.save();ctx.globalAlpha=a;ctx.textAlign='center';
    ctx.font='bold '+Math.round(p.sz)+'px "Comic Sans MS", cursive, sans-serif';
    if(/^[A-Za-z]/.test(p.txt)){ctx.lineWidth=5;ctx.strokeStyle='#3a1a05';ctx.strokeText(p.txt,p.x,p.y);ctx.fillStyle='#ffb347';}
    else ctx.fillStyle='#fff';
    ctx.fillText(p.txt,p.x,p.y);
    ctx.restore();
  }
}

/* ═════════════════════ MAIN LOOP ═════════════════════ */
function render(){
  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,W,H);
  ctx.globalAlpha=1;
  updateShoot();
  drawStars();
  drawMoon();
  drawShoot();
  drawBirds();
  drawFall();
  drawFlyers();
  if(farmSprite)ctx.drawImage(farmSprite,0,farmY,W,H-farmY);
  drawCandles();
  drawFog(false);
  drawGroundPumpkins();
  drawStalks();
  drawDuels();
  drawFog(true);
  drawFloaters();
  drawHangers();
  drawCorners();
  drawWisps();
  drawLights();
  drawTopDrips();
  drawSplats();
  drawFeathers();
  drawSparks();
  drawPops();
  ctx.globalAlpha=1;
}
function frame(ms){
  if(!running)return;
  const now=ms/1000;
  if(last===null)last=now;
  dt=Math.min(0.05,Math.max(0,now-last));last=now;time+=dt;
  render();
  raf=requestAnimationFrame(frame);
}
function start(){if(running)return;running=true;last=null;raf=requestAnimationFrame(frame);}
function stop(){running=false;cancelAnimationFrame(raf);}

/* ═════════════════════ EVENTS ═════════════════════ */
const listeners=[];
function on(t,e,f,o){t.addEventListener(e,f,o);listeners.push([t,e,f,o]);}
let lastSX=0,lastSY=0;
on(window,'mousemove',function(e){
  mouse.x=e.clientX;mouse.y=e.clientY;mouse.active=true;
  if(Math.hypot(mouse.x-lastSX,mouse.y-lastSY)>7){spawnSpark(mouse.x,mouse.y,false);lastSX=mouse.x;lastSY=mouse.y;}
},{passive:true});
on(document,'mouseleave',function(){mouse.active=false;});
function touchPos(e){
  const t=e.touches&&e.touches[0];
  if(t){mouse.x=t.clientX;mouse.y=t.clientY;mouse.active=true;}
}
on(window,'touchstart',touchPos,{passive:true});
on(window,'touchmove',function(e){touchPos(e);spawnSpark(mouse.x,mouse.y,false);},{passive:true});
on(window,'touchend',function(){mouse.active=false;},{passive:true});
on(window,'click',function(e){
  makeSplat(e.clientX,e.clientY,rnd(1.2,1.7));
  for(let i=0;i<14;i++)spawnSpark(e.clientX,e.clientY,true);
  for(let i=0;i<10;i++)spawnFeather(e.clientX,e.clientY,true);
  pop(e.clientX,e.clientY-10,pick(['GOBBLE!','GOBBLE!','BAWK!','\uD83E\uDD83','\uD83C\uDF42','\uD83C\uDF3D','\uD83E\uDD67','\uD83C\uDF41']));
},{passive:true});
let rzT=0;
on(window,'resize',function(){
  clearTimeout(rzT);
  rzT=setTimeout(function(){
    layout();
    initFog();initGroundPumpkins();
  },150);
});

function destroy(){
  stop();
  for(const l of listeners)l[0].removeEventListener(l[1],l[2],l[3]);
  listeners.length=0;
  clearTimeout(rzT);
  ctx.setTransform(1,0,0,1,0,0);ctx.clearRect(0,0,cv.width,cv.height);
}

/* ═════════════════════ GO! ═════════════════════ */
layout();
initStars();initBirds();initFall();initFlyers();initDuels();initHangers();
initStalks();initFloaters();initGroundPumpkins();initFog();initWisps();initTopDrips();
window.ThanksgivingOverlay={start:start,stop:stop,destroy:destroy};
start();
})();
</script>


@code {

    private bool drawerOpen = false;
    private void ToggleDrawer() => drawerOpen = !drawerOpen;
    private bool menuOpen = false;

    private async Task ToggleMenu()
    {
        menuOpen = !menuOpen;
        if (menuOpen)
        {
            await Task.Delay(50); // wait for Blazor to render dropdown
            await JSRuntime.InvokeVoidAsync("initPicker");
        }
    }


    private string currentTime = "";
    private System.Timers.Timer? clockTimer;

    protected override void OnInitialized()
    {
        clockTimer = new System.Timers.Timer(1000); // 1 second interval
        clockTimer.Elapsed += (_, __) => UpdateTime();
        clockTimer.AutoReset = true;
        clockTimer.Enabled = true;
    }
    private string shortTime = "";

    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Give WebGL scene pages a head start to call ready() themselves.
            // If they don't within 800ms, we dismiss the loader.
            await Task.Delay(800);
            await JSRuntime.InvokeVoidAsync("SpectralEngineLoader.ready");
        }
    }
    

    private void UpdateTime()
    {
        try
        {
            var utcNow = DateTime.UtcNow;
            var easternZone = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");
            var easternTime = TimeZoneInfo.ConvertTimeFromUtc(utcNow, easternZone);
            currentTime = easternTime.ToString("dddd, MMMM dd yyyy — hh:mm:ss tt");
            shortTime = easternTime.ToString("h:mm tt");
        }
        catch
        {
            var utcNow = DateTime.UtcNow;
            bool isDst = utcNow.Month >= 3 && utcNow.Month <= 11;
            var easternTime = utcNow.AddHours(isDst ? -4 : -5);
            currentTime = easternTime.ToString("dddd, MMMM dd yyyy — hh:mm:ss tt");
            shortTime = easternTime.ToString("h:mm tt");
        }
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        clockTimer?.Dispose();
    }
}
<script>
    // Apply saved theme color on page load (no picker needed yet)
    function applyColor(color) {
        document.documentElement.style.setProperty("--primary-color", color);
        document.documentElement.style.setProperty("--text-glow", color);
        document.documentElement.style.setProperty("--bg-bottom", color);
        document.documentElement.style.setProperty("--bg-top", color);
        document.documentElement.style.setProperty("--text-color", "#ffffff");
    }

    // Apply theme immediately — no picker access needed here
    const savedTheme = localStorage.getItem("themeColor") || "#00aaff";
    applyColor(savedTheme);

    function initPicker() {
        const picker = document.getElementById("rgbPicker");
        if (!picker) return;

        picker.value = localStorage.getItem("themeColor") || "#00aaff";

        picker.addEventListener("input", (e) => {
            const color = e.target.value;
            applyColor(color);
            localStorage.setItem("themeColor", color);
        });
    }
</script>