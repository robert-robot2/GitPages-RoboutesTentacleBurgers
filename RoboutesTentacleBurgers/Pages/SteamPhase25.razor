    <div class="metric"><div class="val" style="color:#9b59b6">6</div><div class="lbl">Cylinder Shafts</div></div>
    <div class="metric"><div class="val" style="color:#9b59b6">6</div><div class="lbl">Wheels Per Shaft</div></div>
    <div class="metric"><div class="val" style="color:#9b59b6">8"</div><div class="lbl">Wheel Diameter</div></div>
