                }

                body {
                    padding: 15px 10px 40px;
                }

                .hero {
                    padding: 24px;
                }
            }

            /* ---------------- CARDS ---------------- */

            .card {
                position: relative;
                background: var(--panel);
                border: 1px solid var(--border);
                border-radius: 20px;
                padding: 22px;
                box-shadow: var(--shadow);
                backdrop-filter: blur(16px);
            }

            .metric {
                min-height: 140px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                overflow: hidden;
            }

                .metric::before {
                    content: "";
                    position: absolute;
                    width: 100px;
                    height: 100px;
                    right: -35px;
                    bottom: -45px;
                    border-radius: 50%;
                    background: var(--accent);
                    opacity: .08;
                }

            .metric-label {
                color: var(--muted);
                font-size: 12px;
            }

            .metric-number {
                font-size: clamp(25px, 4vw, 36px);
                font-weight: 750;
                letter-spacing: -.04em;
                margin-top: 12px;
            }

            .metric-unit {
                color: #6f788b;
                font-size: 11px;
            }

            .orange {
                --accent: var(--orange);
            }

            .blue {
                --accent: var(--blue);
            }

            .green {
                --accent: var(--green);
            }

            .yellow {
                --accent: var(--yellow);
            }

            .orange .metric-number {
                color: var(--orange2);
            }

            .blue .metric-number {
                color: var(--blue);
            }

            .green .metric-number {
                color: var(--green);
            }

            .yellow .metric-number {
                color: var(--yellow);
            }

            /* ---------------- SECTION HEADERS ---------------- */

            .section {
                margin-top: 18px;
            }

            .section-title {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 12px;
            }

                .section-title h2 {
                    margin: 0;
                    font-size: 16px;
                    letter-spacing: -.01em;
                }

                .section-title span {
                    color: var(--muted);
                    font-size: 11px;
                }

            /* ---------------- CONTROLS ---------------- */

            .controls {
                display: grid;
                gap: 17px;
            }

            .control {
                display: grid;
                grid-template-columns: minmax(190px, 1fr) 2fr 65px;
                align-items: center;
                gap: 15px;
            }

            .control-name {
                color: #cbd2df;
                font-size: 13px;
            }

            .control-value {
                text-align: right;
                font-weight: 700;
                color: var(--text);
                font-variant-numeric: tabular-nums;
            }

            input[type="range"] {
                appearance: none;
                width: 100%;
                height: 5px;
                border-radius: 999px;
                background: linear-gradient( 90deg, var(--orange), var(--blue) );
                outline: none;
            }

                input[type="range"]::-webkit-slider-thumb {
                    appearance: none;
                    width: 18px;
                    height: 18px;
                    border-radius: 50%;
                    border: 3px solid #0b0e15;
                    background: white;
                    box-shadow: 0 0 0 2px rgba(255,112,67,.65), 0 0 18px rgba(255,112,67,.45);
                    cursor: pointer;
                }

                input[type="range"]::-moz-range-thumb {
                    width: 16px;
                    height: 16px;
                    border-radius: 50%;
                    border: 3px solid #0b0e15;
                    background: white;
                    cursor: pointer;
                }

            @@media(max - width: 650px)

            {
                .control {
                    grid-template-columns: 1fr 55px;
                }

                    .control input {
                        grid-column: 1 / -1;
                        grid-row: 2;
                    }
            }

            /* ---------------- CHART ---------------- */

            .chart-card {
                padding-bottom: 15px;
            }

            .chart-wrap {
                position: relative;
                height: 360px;
            }

            .chart-legend {
                display: flex;
                gap: 18px;
                flex-wrap: wrap;
                margin-top: 14px;
                color: var(--muted);
                font-size: 11px;
            }

            .legend-item {
                display: flex;
                align-items: center;
                gap: 7px;
            }

            .legend-dot {
                width: 9px;
                height: 9px;
                border-radius: 50%;
            }

            .legend-orange {
                background: var(--orange);
            }

            .legend-blue {
                background: var(--blue);
            }

            /* ---------------- MILESTONES ---------------- */

            .milestone {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 15px 0;
                border-bottom: 1px solid var(--border);
            }

                .milestone:last-child {
                    border-bottom: 0;
                    padding-bottom: 0;
                }

                .milestone:first-child {
                    padding-top: 0;
                }

            .milestone-label {
                color: #aeb6c7;
                font-size: 13px;
            }

            .milestone-value {
                font-size: 14px;
                font-weight: 750;
                text-align: right;
            }

            .bad {
                color: var(--red);
            }

            .warn {
                color: var(--yellow);
            }

            .good {
                color: var(--green);
            }

            /* ---------------- BARS ---------------- */

            .impact {
                display: grid;
                gap: 18px;
            }

            .impact-row {
                display: grid;
                gap: 7px;
            }

            .impact-head {
                display: flex;
                justify-content: space-between;
                gap: 10px;
                color: #adb5c5;
                font-size: 12px;
            }

            .impact-status {
                font-weight: 700;
            }

            .bar {
                height: 9px;
                border-radius: 999px;
                background: rgba(255,255,255,.06);
                overflow: hidden;
            }

            .fill {
                height: 100%;
                border-radius: inherit;
                transition: width .4s ease;
            }

            .fill-red {
                background: linear-gradient(90deg, #ff4055, #ff765c);
            }

            .fill-yellow {
                background: linear-gradient(90deg, #d99925, #ffd05b);
            }

            .fill-green {
                background: linear-gradient(90deg, #3ccf78, #7af2a1);
            }

            /* ---------------- THEORY ---------------- */

            .theory {
                border-left: 3px solid var(--orange);
            }

            .theory-grid {
                display: grid;
                gap: 0;
            }

            .theory-row {
                display: grid;
                grid-template-columns: 230px 1fr;
                gap: 20px;
                padding: 14px 0;
                border-bottom: 1px solid var(--border);
            }

                .theory-row:last-child {
                    border-bottom: 0;
                }

            .theory-label {
                color: var(--muted);
                font-size: 12px;
            }

            .theory-value {
                color: #d9deea;
                font-size: 13px;
                line-height: 1.5;
            }

            @@media(max - width: 650px)

            {
                .theory-row {
                    grid-template-columns: 1fr;
                    gap: 5px;
                }
            }

            /* ---------------- FOOTER ---------------- */

            .footer {
                color: #626b7e;
                font-size: 11px;
                line-height: 1.7;
                margin-top: 18px;
                padding: 0 5px;
            }

            .tag {
                display: inline-block;
                padding: 4px 8px;
                margin-right: 5px;
                border-radius: 999px;
                background: rgba(255,255,255,.04);
                border: 1px solid var(--border);
                color: #8f98aa;
            }

            /* ---------------- ANIMATION ---------------- */

            .card,
            .hero {
                animation: rise .45s ease both;
            }

            @@keyframes rise {
                from {
                    opacity: 0;
                    transform: translateY(8px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
    </style>


<body>

    <div class="app">

        <!-- HERO -->

        <section class="hero">

            <div class="eyebrow">
                Global resource model · 2026 → 2126
            </div>

            <h1>Resource Stress<br>Projection</h1>

            <p>
                An interactive scenario model exploring how changing oil consumption,
                population growth, and hypothetical steam-vehicle adoption could affect
                petroleum demand and modeled reserves over the next century.
            </p>

            <div class="warning">
                ⚠ Scenario model — not a prediction of human extinction
            </div>

        </section>


        <!-- BASELINE -->

        <div class="section">

            <div class="section-title">
                <h2>Global oil baseline</h2>
                <span>2026 starting conditions</span>
            </div>

            <div class="grid metrics">

                <div class="card metric orange">
                    <div class="metric-label">Proven reserves</div>
                    <div class="metric-number">1.76T</div>
                    <div class="metric-unit">barrels</div>
                </div>

                <div class="card metric blue">
                    <div class="metric-label">Daily consumption</div>
                    <div class="metric-number">103M</div>
                    <div class="metric-unit">barrels / day</div>
                </div>

                <div class="card metric yellow">
                    <div class="metric-label">Static-rate lifetime</div>
                    <div class="metric-number">~47</div>
                    <div class="metric-unit">years of proven reserves</div>
                </div>

                <div class="card metric green">
                    <div class="metric-label">Modeled total reserves</div>
                    <div class="metric-number">4.76T</div>
                    <div class="metric-unit">proven + unproven barrels</div>
                </div>

            </div>

        </div>


        <!-- CONTROLS -->

        <div class="section">

            <div class="section-title">
                <h2>Scenario controls</h2>
                <span>Drag to simulate</span>
            </div>

            <div class="card controls">

                <div class="control">
                    <div class="control-name">
                        Annual consumption growth
                    </div>

                    <input type="range"
                           id="growth"
                           min="0"
                           max="4"
                           step="0.1"
                           value="1.5">

                    <div class="control-value" id="growthOut">
                        1.5%
                    </div>
                </div>


                <div class="control">
                    <div class="control-name">
                        Population growth contribution
                    </div>

                    <input type="range"
                           id="popGrowth"
                           min="0"
                           max="2"
                           step="0.1"
                           value="0.9">

                    <div class="control-value" id="popOut">
                        0.9%
                    </div>
                </div>


                <div class="control">
                    <div class="control-name">
                        Steam adoption by 2050
                    </div>

                    <input type="range"
                           id="steamAdopt"
                           min="0"
                           max="100"
                           step="5"
                           value="40">

                    <div class="control-value" id="steamOut">
                        40%
                    </div>
                </div>

            </div>

        </div>


        <!-- CHART -->

        <div class="section">

            <div class="section-title">
                <h2>100-year depletion projection</h2>
                <span>Remaining modeled reserves</span>
            </div>

            <div class="card chart-card">

                <div class="chart-wrap">
                    <canvas id="oilChart"></canvas>
                </div>

                <div class="chart-legend">

                    <div class="legend-item">
                        <span class="legend-dot legend-orange"></span>
                        Proven reserves
                    </div>

                    <div class="legend-item">
                        <span class="legend-dot legend-blue"></span>
                        Proven + unproven
                    </div>

                </div>

            </div>

        </div>


        <!-- MILESTONES + WATER -->

        <div class="section grid two">

            <div>

                <div class="section-title">
                    <h2>Model milestones</h2>
                    <span>Dynamic output</span>
                </div>

                <div class="card">

                    <div class="milestone">
                        <div class="milestone-label">
                            Proven reserves exhausted
                        </div>

                        <div class="milestone-value bad" id="provenYear">
                            —
                        </div>
                    </div>


                    <div class="milestone">
                        <div class="milestone-label">
                            All modeled reserves exhausted
                        </div>

                        <div class="milestone-value bad" id="totalYear">
                            —
                        </div>
                    </div>


                    <div class="milestone">
                        <div class="milestone-label">
                            Daily consumption — 2076
                        </div>

                        <div class="milestone-value warn" id="cons50">
                            —
                        </div>
                    </div>


                    <div class="milestone">
                        <div class="milestone-label">
                            Daily consumption — 2126
                        </div>

                        <div class="milestone-value bad" id="cons100">
                            —
                        </div>
                    </div>


                    <div class="milestone">
                        <div class="milestone-label">
                            Total modeled oil burned
                        </div>

                        <div class="milestone-value bad" id="totalBurned">
                            —
                        </div>
                    </div>


                    <div class="milestone">
                        <div class="milestone-label">
                            CO₂ from modeled oil
                        </div>

                        <div class="milestone-value bad" id="co2">
                            —
                        </div>
                    </div>

                </div>

            </div>


            <div>

                <div class="section-title">
                    <h2>Steam water system</h2>
                    <span>Fleet comparison</span>
                </div>

                <div class="card">

                    <div class="milestone">
                        <div class="milestone-label">
                            Global vehicle fleet
                        </div>

                        <div class="milestone-value">
                            1.5B
                        </div>
                    </div>


                    <div class="milestone">
                        <div class="milestone-label">
                            Water top-up / car / day
                        </div>

                        <div class="milestone-value good">
                            ~4 L
                        </div>
                    </div>


                    <div class="milestone">
                        <div class="milestone-label">
                            Fleet daily water
                        </div>

                        <div class="milestone-value good" id="waterDay">
                            —
                        </div>
                    </div>


                    <div class="milestone">
                        <div class="milestone-label">
                            Fleet annual water
                        </div>

                        <div class="milestone-value good" id="waterYear">
                            —
                        </div>
                    </div>


                    <div class="milestone">
                        <div class="milestone-label">
                            Ocean volume
                        </div>

                        <div class="milestone-value">
                            1.335B km³
                        </div>
                    </div>


                    <div class="milestone">
                        <div class="milestone-label">
                            Oil / water volume ratio
                        </div>

                        <div class="milestone-value bad" id="oilVsWater">
                            —
                        </div>
                    </div>

                </div>

            </div>

        </div>


        <!-- IMPACT -->

        <div class="section">

            <div class="section-title">
                <h2>Environmental impact comparison</h2>
                <span>Qualitative scenario indicators</span>
            </div>

            <div class="card impact">

                <div class="impact-row">

                    <div class="impact-head">
                        <span>Oil — extraction-induced seismicity</span>
                        <span class="impact-status bad">HIGH</span>
                    </div>

                    <div class="bar">
                        <div class="fill fill-red" style="width:85%"></div>
                    </div>

                </div>


                <div class="impact-row">

                    <div class="impact-head">
                        <span>Steam — seismic disruption</span>
                        <span class="impact-status good">LOW</span>
                    </div>

                    <div class="bar">
                        <div class="fill fill-green" style="width:3%"></div>
                    </div>

                </div>


                <div class="impact-row">

                    <div class="impact-head">
                        <span>Oil — atmospheric CO₂</span>
                        <span class="impact-status bad">VERY HIGH</span>
                    </div>

                    <div class="bar">
                        <div class="fill fill-red" style="width:98%"></div>
                    </div>

                </div>


                <div class="impact-row">

                    <div class="impact-head">
                        <span>Steam — atmospheric impact</span>
                        <span class="impact-status good">LOW</span>
                    </div>

                    <div class="bar">
                        <div class="fill fill-green" style="width:3%"></div>
                    </div>

                </div>


                <div class="impact-row">

                    <div class="impact-head">
                        <span>Oil — ground subsidence</span>
                        <span class="impact-status warn">SIGNIFICANT</span>
                    </div>

                    <div class="bar">
                        <div class="fill fill-yellow" style="width:75%"></div>
                    </div>

                </div>


                <div class="impact-row">

                    <div class="impact-head">
                        <span>Steam — direct ground impact</span>
                        <span class="impact-status good">LOW</span>
                    </div>

                    <div class="bar">
                        <div class="fill fill-green" style="width:2%"></div>
                    </div>

                </div>

            </div>

        </div>


        <!-- THEORY -->

        <div class="section">

            <div class="section-title">
                <h2>Tectonic & geological hypothesis</h2>
                <span>Interpretation layer</span>
            </div>

            <div class="card theory">

                <div class="theory-grid">

                    <div class="theory-row">
                        <div class="theory-label">Oil & porous formations</div>

                        <div class="theory-value">
                            Hydrocarbon extraction changes fluid pressure and effective
                            stresses within subsurface formations.
                        </div>
                    </div>


                    <div class="theory-row">
                        <div class="theory-label">Extraction effect</div>

                        <div class="theory-value">
                            Pressure changes can contribute to induced seismicity in some
                            geological settings.
                        </div>
                    </div>


                    <div class="theory-row">
                        <div class="theory-label">Subsidence</div>

                        <div class="theory-value">
                            Fluid extraction can contribute to ground deformation and
                            subsidence where geological conditions permit it.
                        </div>
                    </div>


                    <div class="theory-row">
                        <div class="theory-label">After extraction stops</div>

                        <div class="theory-value">
                            Subsurface pressures can change again as formations equilibrate,
                            but the response varies greatly by geology and reservoir.
                        </div>
                    </div>


                    <div class="theory-row">
                        <div class="theory-label">Oil regeneration</div>

                        <div class="theory-value warn">
                            Natural petroleum formation occurs on geological timescales,
                            not human timescales.
                        </div>
                    </div>


                    <div class="theory-row">
                        <div class="theory-label">Important limitation</div>

                        <div class="theory-value">
                            This model does not establish that oil depletion would cause
                            human extinction or destabilise global plate tectonics.
                        </div>
                    </div>

                </div>

            </div>

        </div>


        <!-- FOOTER -->

        <div class="footer">

            <span class="tag">SCENARIO MODEL</span>
            <span class="tag">NOT A FORECAST</span>
            <span class="tag">2026–2126</span>

            <p>
                The reserve and consumption figures are model inputs. The projection
                assumes exponential consumption growth and a simplified hypothetical
                reduction from steam adoption. Real-world petroleum production depends
                on discoveries, economics, technology, policy, substitution, demand
                changes, and resource definitions. Results should therefore be read as
                scenario outputs rather than a forecast.
            </p>

        </div>

    </div>


    <script>

            let chart = null;


            /* --------------------------------
               DOM
            -------------------------------- */

            const growth = document.getElementById("growth");
            const popGrowth = document.getElementById("popGrowth");
            const steamAdopt = document.getElementById("steamAdopt");

            const growthOut = document.getElementById("growthOut");
            const popOut = document.getElementById("popOut");
            const steamOut = document.getElementById("steamOut");


            /* --------------------------------
               EVENTS
            -------------------------------- */

            growth.addEventListener("input", () => {
                growthOut.textContent = growth.value + "%";
                calc();
            });

            popGrowth.addEventListener("input", () => {
                popOut.textContent = popGrowth.value + "%";
                calc();
            });

            steamAdopt.addEventListener("input", () => {
                steamOut.textContent = steamAdopt.value + "%";
                calc();
            });


            /* --------------------------------
               MODEL
            -------------------------------- */

            function calc() {

                const consumptionGrowth =
                    parseFloat(growth.value) / 100;

                const populationGrowth =
                    parseFloat(popGrowth.value) / 100;

                const steam =
                    parseFloat(steamAdopt.value) / 100;


                const provenReserves = 1.76e12;
                const totalReserves = 4.76e12;

                const dailyBase = 103e6;
                const annualBase = dailyBase * 365;


                let proven = provenReserves;
                let total = totalReserves;

                let annual = annualBase;

                let provenYear = null;
                let totalYear = null;

                let totalBurned = 0;


                const years = [];
                const provenArr = [];
                const totalArr = [];
                const consumeArr = [];


                for (let y = 0; y <= 100; y++) {

                    const year = 2026 + y;


                    /*
                      Population growth is included as an additional
                      demand pressure. We scale its contribution so that
                      the two sliders remain separate rather than simply
                      adding both rates 1:1.
                    */

                    const effectiveGrowth =
                        consumptionGrowth +
                        (populationGrowth * 0.35);


                    /*
                      Hypothetical steam adoption effect.

                      This is intentionally a scenario parameter,
                      not a claim about real-world adoption.
                    */

                    let adoptionFactor;

                    if (y <= 24) {

                        adoptionFactor =
                            1 -
                            (steam * (y / 24) * 0.5);

                    } else {

                        adoptionFactor =
                            1 -
                            (steam * 0.5) -
                            (
                                steam *
                                0.3 *
                                (Math.min(y - 24, 26) / 26)
                            );
                    }


                    const adjustedAnnual =
                        annual *
                        Math.max(0.2, adoptionFactor);


                    years.push(year);

                    provenArr.push(
                        Math.max(
                            0,
                            Math.round(proven / 1e9)
                        )
                    );

                    totalArr.push(
                        Math.max(
                            0,
                            Math.round(total / 1e9)
                        )
                    );

                    consumeArr.push(
                        Math.round(
                            adjustedAnnual / 1e9 * 10
                        ) / 10
                    );


                    if (
                        proven > 0 &&
                        proven - adjustedAnnual <= 0 &&
                        !provenYear
                    ) {
                        provenYear = year;
                    }


                    if (
                        total > 0 &&
                        total - adjustedAnnual <= 0 &&
                        !totalYear
                    ) {
                        totalYear = year;
                    }


                    totalBurned += Math.min(
                        adjustedAnnual,
                        Math.max(0, total)
                    );


                    proven = Math.max(
                        0,
                        proven - adjustedAnnual
                    );

                    total = Math.max(
                        0,
                        total - adjustedAnnual
                    );


                    annual *=
                        1 + effectiveGrowth;
                }


                /* --------------------------------
                   OUTPUTS
                -------------------------------- */

                const cons50 = consumeArr[50];
                const cons100 = consumeArr[100];


                const co2 =
                    Math.round(
                        totalBurned *
                        0.43 /
                        1e12 *
                        10
                    ) / 10;


                document.getElementById("provenYear")
                    .textContent =
                    provenYear || "Beyond 2126";


                document.getElementById("totalYear")
                    .textContent =
                    totalYear || "Beyond 2126";


                document.getElementById("cons50")
                    .textContent =
                    (cons50 * 1000).toFixed(0) +
                    "M bbl/day";


                document.getElementById("cons100")
                    .textContent =
                    (cons100 * 1000).toFixed(0) +
                    "M bbl/day";


                document.getElementById("totalBurned")
                    .textContent =
                    (totalBurned / 1e12).toFixed(2) +
                    "T barrels";


                document.getElementById("co2")
                    .textContent =
                    co2 +
                    "T tonnes CO₂";


                /* --------------------------------
                   WATER MODEL
                -------------------------------- */

                const fleet =
                    1.5e9 *
                    (1 - steam * 0.5);


                const waterDay =
                    Math.round(
                        fleet * 4 / 1e9 * 100
                    ) / 100;


                const waterYear =
                    Math.round(
                        waterDay * 365 * 100
                    ) / 100;


                document.getElementById("waterDay")
                    .textContent =
                    waterDay.toFixed(2) +
                    "B L/day";


                document.getElementById("waterYear")
                    .textContent =
                    waterYear.toFixed(0) +
                    "B L/year";


                const oilVolume =
                    annualBase * 159;


                const waterVolume =
                    waterDay * 1e9 * 365;


                document.getElementById("oilVsWater")
                    .textContent =
                    Math.round(
                        oilVolume / waterVolume
                    ) + "×";


                /* --------------------------------
                   CHART
                -------------------------------- */

                const dark = true;

                const gridColor =
                    "rgba(255,255,255,.055)";

                const textColor =
                    "#778196";


                if (chart) {
                    chart.destroy();
                }


                chart = new Chart(
                    document.getElementById("oilChart"),
                    {

                        type: "line",

                        data: {

                            labels: years,

                            datasets: [

                                {
                                    label: "Proven reserves",
                                    data: provenArr,

                                    borderColor: "#ff7043",

                                    backgroundColor:
                                        "rgba(255,112,67,.10)",

                                    borderWidth: 2.5,

                                    pointRadius: 0,

                                    tension: .35,

                                    fill: true
                                },


                                {
                                    label: "All modeled reserves",
                                    data: totalArr,

                                    borderColor: "#4da3ff",

                                    backgroundColor:
                                        "rgba(77,163,255,.04)",

                                    borderWidth: 2,

                                    pointRadius: 0,

                                    tension: .35,

                                    fill: true,

                                    borderDash: [7, 5]
                                }

                            ]
                        },


                        options: {

                            responsive: true,

                            maintainAspectRatio: false,

                            interaction: {
                                mode: "index",
                                intersect: false
                            },


                            plugins: {

                                legend: {
                                    display: false
                                },


                                tooltip: {

                                    backgroundColor:
                                        "#111722",

                                    borderColor:
                                        "rgba(255,255,255,.1)",

                                    borderWidth: 1,

                                    padding: 12,

                                    titleColor: "#fff",

                                    bodyColor: "#b9c1d1",

                                    callbacks: {

                                        label: ctx =>
                                            ctx.dataset.label +
                                            ": " +
                                            ctx.parsed.y.toLocaleString() +
                                            " Gb"

                                    }
                                }

                            },


                            scales: {

                                x: {

                                    ticks: {
                                        color: textColor,
                                        maxTicksLimit: 9
                                    },

                                    grid: {
                                        color: gridColor
                                    }

                                },


                                y: {

                                    beginAtZero: true,

                                    ticks: {

                                        color: textColor,

                                        callback: value =>
                                            value + " Gb"

                                    },

                                    grid: {
                                        color: gridColor
                                    },

                                    title: {

                                        display: true,

                                        text:
                                            "Remaining billion barrels",

                                        color: textColor,

                                        font: {
                                            size: 11
                                        }
                                    }

                                }

                            }

                        }

                    }
                );

            }


            /* INITIALIZE */

            calc();

    </script>

</body>
