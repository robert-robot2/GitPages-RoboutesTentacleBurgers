<style>
  @@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@400;600;700&display=swap');

  :root {
    --bg: #020810;
    --surface: #050f1e;
    --border: #0a2a4a;
    --glow: #00aaff;
    --glow-dim: #0055aa;
    --glow-soft: rgba(0,170,255,0.08);
    --red: #ff3333;
    --red-dim: rgba(255,51,51,0.15);
    --amber: #ffaa00;
    --amber-dim: rgba(255,170,0,0.12);
    --green: #00ff88;
    --green-dim: rgba(0,255,136,0.1);
    --text: #c8dff0;
    --text-dim: #4a6a8a;
    --mono: 'Share Tech Mono', monospace;
    --sans: 'Rajdhani', sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    min-height: 100vh;
    padding: 20px;
  }

  .page-header {
    text-align: center;
    padding: 30px 20px 20px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 30px;
  }

  .page-header h1 {
    font-family: var(--mono);
    font-size: clamp(1.1rem, 3vw, 1.6rem);
    color: var(--glow);
    text-shadow: 0 0 20px var(--glow), 0 0 40px var(--glow-dim);
    letter-spacing: 0.1em;
    margin-bottom: 8px;
  }

  .page-header p {
    color: var(--text-dim);
    font-size: 0.85rem;
    font-family: var(--mono);
    letter-spacing: 0.05em;
  }

  /* MASTER TIMELINE TRACK */
  .timeline-wrapper {
    position: relative;
    margin-bottom: 40px;
  }

  .timeline-track {
    position: relative;
    width: 100%;
    height: 60px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    margin-bottom: 8px;
    overflow: visible;
  }

  .timeline-bar {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--glow-dim), var(--glow), var(--glow-dim));
    transform: translateY(-50%);
  }

  .time-labels {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--text-dim);
    padding: 0 4px;
    margin-bottom: 30px;
  }

  /* EVENT MARKERS ON TIMELINE */
  .event-marker {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 10;
  }

  .event-marker .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid;
    background: var(--bg);
    transition: all 0.2s;
    position: relative;
  }

  .event-marker:hover .dot {
    transform: scale(1.5);
  }

  .event-marker .label {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 0.6rem;
    pointer-events: none;
  }

  .event-marker.confirmed .dot { border-color: var(--green); box-shadow: 0 0 8px var(--green); }
  .event-marker.confirmed .label { color: var(--green); }
  .event-marker.disputed .dot { border-color: var(--amber); box-shadow: 0 0 8px var(--amber); }
  .event-marker.disputed .label { color: var(--amber); }
  .event-marker.prosecution .dot { border-color: var(--red); box-shadow: 0 0 8px var(--red); }
  .event-marker.prosecution .label { color: var(--red); }
  .event-marker.medical .dot { border-color: var(--glow); box-shadow: 0 0 8px var(--glow); }
  .event-marker.medical .label { color: var(--glow); }

  /* CONFLICT ZONE */
  .conflict-zone {
    position: absolute;
    top: 0;
    height: 100%;
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 4px,
      rgba(255,51,51,0.05) 4px,
      rgba(255,51,51,0.05) 8px
    );
    border-left: 1px dashed var(--red);
    border-right: 1px dashed var(--glow);
    pointer-events: none;
  }

  /* SLIDER SECTION */
  .sliders-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 30px;
  }

  @@media (max-width: 700px) {
    .sliders-grid { grid-template-columns: 1fr; }
  }

  .slider-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 16px;
    position: relative;
    overflow: hidden;
  }

  .slider-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 3px; height: 100%;
  }

  .slider-card.confirmed::before { background: var(--green); }
  .slider-card.disputed::before { background: var(--amber); }
  .slider-card.prosecution::before { background: var(--red); }
  .slider-card.medical::before { background: var(--glow); }

  .slider-card h3 {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  .slider-card.confirmed h3 { color: var(--green); }
  .slider-card.disputed h3 { color: var(--amber); }
  .slider-card.prosecution h3 { color: var(--red); }
  .slider-card.medical h3 { color: var(--glow); }

  .slider-card .evidence-note {
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-bottom: 12px;
    line-height: 1.4;
    font-family: var(--mono);
  }

  .slider-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .slider-row label {
    font-size: 0.7rem;
    color: var(--text-dim);
    font-family: var(--mono);
    width: 80px;
    flex-shrink: 0;
  }

  .slider-row input[type=range] {
    flex: 1;
    -webkit-appearance: none;
    height: 3px;
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }

  .slider-card.confirmed input[type=range] { background: var(--green-dim); }
  .slider-card.confirmed input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 14px; height: 14px;
    border-radius: 50%; background: var(--green);
    box-shadow: 0 0 6px var(--green); cursor: pointer;
  }

  .slider-card.disputed input[type=range] { background: var(--amber-dim); }
  .slider-card.disputed input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 14px; height: 14px;
    border-radius: 50%; background: var(--amber);
    box-shadow: 0 0 6px var(--amber); cursor: pointer;
  }

  .slider-card.prosecution input[type=range] { background: var(--red-dim); }
  .slider-card.prosecution input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 14px; height: 14px;
    border-radius: 50%; background: var(--red);
    box-shadow: 0 0 6px var(--red); cursor: pointer;
  }

  .slider-card.medical input[type=range] { background: var(--glow-soft); }
  .slider-card.medical input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 14px; height: 14px;
    border-radius: 50%; background: var(--glow);
    box-shadow: 0 0 6px var(--glow); cursor: pointer;
  }

  .slider-row .time-display {
    font-family: var(--mono);
    font-size: 0.75rem;
    width: 52px;
    text-align: right;
    flex-shrink: 0;
  }

  .slider-card.confirmed .time-display { color: var(--green); }
  .slider-card.disputed .time-display { color: var(--amber); }
  .slider-card.prosecution .time-display { color: var(--red); }
  .slider-card.medical .time-display { color: var(--glow); }

  /* CONFLICT ANALYSIS BOX */
  .conflict-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 20px;
    margin-bottom: 30px;
  }

  .conflict-box h2 {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--glow);
    text-transform: uppercase;
    margin-bottom: 16px;
    text-shadow: 0 0 10px var(--glow-dim);
  }

  .conflict-result {
    font-family: var(--mono);
    font-size: 0.85rem;
    line-height: 1.8;
    padding: 16px;
    border-radius: 4px;
    border: 1px solid;
    transition: all 0.3s;
  }

  .conflict-result.overlap {
    border-color: var(--red);
    background: var(--red-dim);
    color: #ffaaaa;
  }

  .conflict-result.no-overlap {
    border-color: var(--green);
    background: var(--green-dim);
    color: #aaffcc;
  }

  .conflict-result.partial {
    border-color: var(--amber);
    background: var(--amber-dim);
    color: #ffd580;
  }

  .conflict-verdict {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  /* EVIDENCE TABLE */
  .evidence-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 0.72rem;
    margin-bottom: 30px;
  }

  .evidence-table th {
    background: var(--surface);
    color: var(--glow);
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid var(--glow-dim);
    letter-spacing: 0.06em;
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .evidence-table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    line-height: 1.5;
  }

  .evidence-table tr:hover td {
    background: var(--glow-soft);
  }

  .badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 2px;
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .badge.confirmed { background: var(--green-dim); color: var(--green); border: 1px solid var(--green); }
  .badge.disputed { background: var(--amber-dim); color: var(--amber); border: 1px solid var(--amber); }
  .badge.prosecution { background: var(--red-dim); color: var(--red); border: 1px solid var(--red); }
  .badge.medical { background: var(--glow-soft); color: var(--glow); border: 1px solid var(--glow-dim); }
  .badge.unknown { background: rgba(100,100,100,0.2); color: #888; border: 1px solid #444; }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
    font-family: var(--mono);
    font-size: 0.65rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .legend-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
  }

  .section-label {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }
</style>



