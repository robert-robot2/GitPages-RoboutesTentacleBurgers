<div style="
    position: absolute;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: radial-gradient(ellipse at center, rgba(20,0,0,0.85) 0%, rgba(0,0,0,0.96) 100%);
    pointer-events: all;
    font-family: 'Courier New', monospace;">

    @* ── Title ────────────────────────────────────────────────────── *@
    <div style="
        font-size: 3.5rem;
        font-family: 'Diablo', 'Courier New', monospace;
        font-weight: normal;
        letter-spacing: 0.08em;
        color: #cc2200;
        text-shadow: 0 0 18px #ff4400, 0 0 40px #aa1100, 0 0 80px #660000;
        margin-bottom: 8px;
        text-transform: none;
        text-align: center;">
        Choose Your Champion
    </div>

    <div style="
        font-size: 0.72rem;
        font-family: 'Diablo', 'Courier New', monospace;
        color: rgba(204,34,0,0.5);
        letter-spacing: 0.12em;
        margin-bottom: 28px;">
        SELECT A CHARACTER TO BEGIN
    </div>

    @* ── Character Grid ───────────────────────────────────────────── *@
    <div style="
        display: flex;
        flex-direction: row;
        gap: 16px;
        align-items: flex-end;
        margin-bottom: 28px;">

        @foreach (var c in _characters)
        {
            bool isSelected = _selectedChar == c.Key;
            bool isLocked = string.IsNullOrEmpty(c.Key);

            <div @onclick="@(() => { if (!isLocked) _selectedChar = c.Key; })"
                 style="
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 8px;
                cursor: @(isLocked ? "default" : "pointer");
                opacity: @(isLocked ? "0.35" : "1");
                transition: transform 0.12s ease;">

                @* Portrait frame *@
                <div style="
                    border: 2px solid @(isSelected ? "#cc2200" : "rgba(255,255,255,0.12)");
                    border-radius: 6px;
                    box-shadow: @(isSelected ? "0 0 18px #cc220088" : "none");
                    overflow: hidden;
                    width: 100px;
                    height: 130px;
                    background: rgba(0,0,0,0.5);
                    transition: border 0.12s, box-shadow 0.12s;">
                    <img src="@c.Art"
                         alt="@c.Name"
                         style="width:100%; height:100%; object-fit:cover; display:block;" />
                </div>

                <div style="
                    font-size: 0.72rem;
                    font-family: 'Diablo', 'Courier New', monospace;
                    letter-spacing: 0.1em;
                    color: @(isSelected ? "#ff4400" : "rgba(204,34,0,0.5)");
                    text-shadow: @(isSelected ? "0 0 12px #ff4400, 0 0 40px #aa1100" : "none");
                    text-transform: uppercase;">
                    @(isLocked ? "???" : c.Name)
                </div>

            </div>
        }

    </div>

    @* ── Selected Character Summary ───────────────────────────────── *@
    <div style="
        min-height: 32px;
        font-size: 0.78rem;
        font-family: 'Diablo', 'Courier New', monospace;
        color: #cc2200;
        letter-spacing: 0.1em;
        margin-bottom: 20px;
        text-shadow: 0 0 12px #ff4400, 0 0 40px #aa1100;">
        @if (!string.IsNullOrEmpty(_selectedChar))
        {
            @($"{_selectedChar.ToUpper()} SELECTED")
        }
    </div>

    @* ── Action Buttons ───────────────────────────────────────────── *@
    <div style="display:flex; gap:14px; margin-bottom:24px;">

        <button style="@ActionButtonStyle("#1a6b3a", "#2ecc71")"
                disabled="@string.IsNullOrEmpty(_selectedChar)"
                @onclick="OnStartPressed">
            START
        </button>

        <button style="@ActionButtonStyle("#882200", "#cc4400")"
                @onclick="OnRMainMenuPressed">
            MAIN MENU
        </button>

    </div>

    <div style="
        position: absolute;
        bottom: 18px;
        font-family: 'Diablo', 'Courier New', monospace;
        font-size: 1.5rem;
        color: rgba(204,34,0,0.25);
        letter-spacing: 0.12em;">
        PRESS 5 TO CLOSE
    </div>

</div>

@code {

    [Parameter] public EventCallback<string> OnCharacterSelected { get; set; }
    [Parameter] public EventCallback OnStart { get; set; }
    [Parameter] public EventCallback OnRMainMenu { get; set; }

    private string _selectedChar = "";

    // ── Character definitions ─────────────────────────────────────
    private record CharDef(string Key, string Name, string Art);

    private static readonly CharDef[] _characters = new[]
    {
        new CharDef("Warrior", "Warrior", "/iAssets/Warriorart01.png"),
        new CharDef("",        "???",     "/iAssets/QuestionArt001.png"),  // placeholder slot
        new CharDef("Rogue",   "Rogue",   "/iAssets/D1RogueArt.png"),
        new CharDef("Mage",    "Mage",    "/iAssets/D1MageSelect01.png"),
        new CharDef("Monk",    "Monk",    "/iAssets/MonkArt001.png"),
    };

    private string ActionButtonStyle(string border, string glow) =>
      $"padding:12px 24px; font-size:1.2rem; " +
      $"font-family:'Diablo','Courier New',monospace; letter-spacing:0.14em; " +
      $"background:transparent; color:#cc2200; " +
      $"border:none; outline:none; cursor:pointer; " +
      $"text-shadow:0 0 12px #ff4400, 0 0 40px #aa1100;";

    private async Task OnStartPressed()
    {
        if (string.IsNullOrEmpty(_selectedChar)) return;
        await OnCharacterSelected.InvokeAsync(_selectedChar);
        await OnStart.InvokeAsync();
    }

    private async Task OnRMainMenuPressed() => await OnRMainMenu.InvokeAsync();
}
